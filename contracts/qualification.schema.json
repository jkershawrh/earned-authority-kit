{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:earned-authority:qualification:0.1.0-draft.1",
  "title": "qualification",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft.1"
    },
    "qualification_id": {
      "type": "string",
      "minLength": 1
    },
    "skill_id": {
      "type": "string",
      "minLength": 1
    },
    "skill_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71
    },
    "context_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71
    },
    "qualification_revision": {
      "type": "integer",
      "minimum": 1
    },
    "evaluator_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71
    },
    "outcome_refs": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "observed_from_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "observed_until_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "expires_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "disposition": {
      "enum": [
        "ELIGIBLE",
        "HOLD",
        "INELIGIBLE"
      ]
    },
    "evidence_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71
    }
  },
  "required": [
    "schema_version",
    "qualification_id",
    "skill_id",
    "skill_digest",
    "context_digest",
    "qualification_revision",
    "evaluator_digest",
    "policy_digest",
    "outcome_refs",
    "observed_from_ms",
    "observed_until_ms",
    "expires_at_ms",
    "disposition",
    "evidence_digest"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "ELIGIBLE"
          }
        }
      },
      "then": {
        "properties": {
          "outcome_refs": {
            "minItems": 1
          },
          "observed_from_ms": {
            "type": "integer"
          },
          "observed_until_ms": {
            "type": "integer"
          }
        }
      }
    }
  ]
}
