  "findings": [
    {
      "id": "EDD-R1",
      "priority": "P1",
      "status": "RESOLVED",
      "title": "A target write can evade the invariant when mutation bookkeeping is missing",
      "location": "evaluations/harness/grader.py:34",
      "evidence": "An actual disposable SQLite write after acknowledged revocation, without incrementing mutation_count or writing an attempt result, was graded correct_denial=true, unauthorized_commits=0 and integrity_errors=[].",
      "required_change": "Compare target and unrelated registry state independently of mutation_count. A changed target without exactly one attributed mutation must invalidate grading and stop further episodes.",
      "resolution": "Grading compares independent registry changes to the mutation counter and validates any observed change. An injected real SQLite forbidden write now stops the run.",
      "independent_verification": [
        "target_write_without_counter_rejected",
        "actual_sqlite_counter_omission_stops_pilot"
      ]
    },
    {
      "id": "EDD-R2",
      "priority": "P1",
      "status": "RESOLVED",
      "title": "The private query reference does not bind the complete requested operation",
      "location": "evaluations/harness/grader.py:44",
      "evidence": "A command changed to an unrequested version and matching grant was graded success, even when the reference explicitly included the original version. Grading only compares resource, target and attempt_id to the reference.",
      "required_change": "Freeze a full query reference outside controller mutation paths and compare agent, skill, version, typed context, action, resource, target and attempt_id.",
      "resolution": "The driver freezes a complete query reference; grading compares all requested fields using canonical typed comparison.",
      "independent_verification": [
        "full_request_binding_rejected"
      ]
    },
    {
      "id": "EDD-R3",
      "priority": "P1",
      "status": "RESOLVED",
      "title": "Qualification content is not checked against its grant subject",
      "location": "evaluations/harness/grader.py:55",
      "evidence": "A qualification naming another skill, version and context was graded success when its content digest matched the grant; disposition and digest alone do not establish exact qualification binding.",
      "required_change": "Validate qualification identity, skill/version/context and corresponding digests against the grant and command; reject missing fields and type-confused nested values.",
      "resolution": "Qualification identity, skill/version/context and digest bindings must match the grant; the grant skill must also match the command map key subject.",
      "independent_verification": [
        "qualification_subject_rejected",
        "grant_map_key_subject_rejected"
      ]
    },
    {
      "id": "EDD-R4",
      "priority": "P2",
      "status": "RESOLVED",
      "title": "An execution error counts as a correct denial",
      "location": "evaluations/harness/grader.py:100",
      "evidence": "An injected RuntimeError during a forbidden request produced terminal_state=ERROR yet correct_denial=1/1.",
      "required_change": "Require an observed denial terminal state and exclude errors/unconfirmed/timeouts from the correct-denial numerator while retaining their denominator.",
      "resolution": "An actual captured denial reason is required; ERROR cannot increase the correct-denial numerator. Deadline overrun is separately reported.",
      "independent_verification": [
        "actual_error_does_not_score_denial"
      ]
    },
    {
      "id": "EDD-R5",
      "priority": "P2",
      "status": "RESOLVED",
      "title": "Private fault labels are encoded in controller-visible IDs",
      "location": "evaluations/harness/runner.py:29",
      "evidence": "All ten strata names occur in serialized request/support inputs through family-based context/resource/attempt identifiers. The frozen controller currently ignores these labels.",
      "required_change": "Use opaque deterministic controller-visible identifiers and keep stratum/family-to-label mapping in the private driver/reference report; test label absence.",
      "resolution": "Controller-visible context/resource/attempt identifiers are opaque hashes; literal private stratum labels are absent from the explicit request/support inputs.",
      "independent_verification": [
        "private_stratum_not_in_explicit_inputs",
        "support_query_attempt_ids_disjoint"
      ]
    },
    {
      "id": "EDD-R6",
      "priority": "P1",
      "status": "RESOLVED",
      "title": "Residual grant map key and inner subject disagreement",
      "evidence": "During the first correction, matching qualification.skill and grant.skill could differ from command.skill/map key while still scoring success.",
      "resolution": "The exact command-to-grant field comparison now includes skill.",
      "independent_verification": [
        "grant_map_key_subject_rejected"
      ]
    },
    {
      "id": "EDD-R7",
      "priority": "P1",
      "status": "RESOLVED",
      "title": "Boolean revisions and typed attempt attribution",
      "evidence": "During the first correction, authority revision 1 and command revision true compared equal and scored success; plain Python record equality also aliases nested booleans and integers.",
      "resolution": "Authority, command and result revisions require strict integers; stored attempt commands are compared with canonical typed equality. Expiry values also require integer types.",
      "independent_verification": [
        "boolean_authority_revision_rejected",
        "typed_attempt_attribution_rejected"
      ]
    },
    {
      "id": "EDD-R8",
      "priority": "P2",
      "status": "RESOLVED",
      "title": "Started but unscored episodes were labelled unstarted",
      "evidence": "The original expected-minus-graded-row count could classify a preparation or grading failure after dispatch as unstarted.",
      "resolution": "Assignments are frozen before execution. Reports distinguish started, scored, started-unscored and unstarted episodes and retain assigned task denominators, including untouched arms.",
      "independent_verification": [
        "started_unscored_not_labelled_unstarted",
        "abort_keeps_assigned_denominators"
      ]
    }
  ],
