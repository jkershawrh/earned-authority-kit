  "findings": [
    {
      "id": "SEQ-R1",
      "priority": "P1",
      "status": "RESOLVED",
      "title": "Missing phase acceptance gate",
      "evidence": "Forcing only retained_success admission to deny still produced COMPLETED/GREEN. Invariant-only checks do not establish the named lifecycle behavior.",
      "required_change": "Gate declared expected phase success/denial and observed withdrawal/requalification states in the runner, retaining the failing row and stopping subsequent phases.",
      "resolution": "Each phase is gated against declared success/denial, disposition, deadline and failure-withdrawal expectations before the next phase.",
      "independent_verification": "negative_control_unexpected_retained_denial"
    },
    {
      "id": "SEQ-R2",
      "priority": "P1",
      "status": "RESOLVED",
      "title": "Support preparation writes are outside the grading window",
      "evidence": "A Runtime.shadow wrapper performed an actual unauthorized write to the unrelated sentinel. Every sequence phase and the whole report remained GREEN with no integrity errors.",
      "required_change": "Read registry/counter before preparation, compare after preparation, and forbid any preparation mutation before querying. Preserve prior-query continuity. Apply the same boundary to independent pilot preparation.",
      "resolution": "Both runners preserve a registry/counter snapshot before support preparation and reject changes. The sequential runner also preserves registry continuity between sealed phases.",
      "independent_verification": "negative_control_support_side_effect"
    },
    {
      "id": "SEQ-R3",
      "priority": "P1",
      "status": "RESOLVED",
      "title": "Qualification disposition is fabricated for the withdrawn phase",
      "evidence": "After leaving actual persisted qualification ELIGIBLE while retaining the revoked authority, withdrawn_query reported qualification_disposition=INELIGIBLE even though prepared_qualification.disposition=ELIGIBLE, and the report remained GREEN.",
      "required_change": "Read the actual disposition and compare against the declared expected transition; do not insert expected labels as observed results.",
      "resolution": "The withdrawn phase reads the persisted disposition; the failure phase also checks stored INELIGIBLE state, actual withdrawal and acknowledgement.",
      "independent_verification": "negative_control_hardcoded_qualification_disposition"
    },
    {
      "id": "SEQ-R4",
      "priority": "P1",
      "status": "RESOLVED",
      "title": "Retained failure deletion is not detected",
      "evidence": "Deleting the actual SQLite FAIL observation during recovery support preserved all expected task/denial outcomes and COMPLETED/GREEN; recovery observations contained no FAIL despite the explicit retention claim.",
      "required_change": "Require every previously retained observation identity and canonical content to remain through preparation and query boundaries; detect removal or alteration before continuing.",
      "resolution": "Previously retained observation identities and exact content must survive preparation and queries; deleting the old failure stops recovery.",
      "independent_verification": "negative_control_failure_deleted_during_recovery"
    },
    {
      "id": "SEQ-R5",
      "priority": "P1",
      "status": "RESOLVED",
      "title": "Admission mutation can escape the grading window",
      "evidence": "An actual unrelated sentinel mutation inside admit is incorporated into a replacement before snapshot; the corrected runner still returned COMPLETED/GREEN.",
      "required_change": "Preserve and compare the registry/counter baseline across admission and maintain continuity from the prior sealed phase.",
      "resolution": "Both runners compare pre-admission registry/counter state to the admitted snapshot before moving the commit grading boundary.",
      "independent_verification": "negative_control_admission_side_effect"
    },
    {
      "id": "SEQ-R6",
      "priority": "P1",
      "status": "RESOLVED",
      "title": "New support observations can be deleted during their first query",
      "evidence": "Deleting all three newly added support observations after query0 left only the query observation. Because retention compared pre-support observations, the entire run returned COMPLETED/GREEN.",
      "required_change": "Capture post-preparation observations and require that exact evidence to survive the query.",
      "resolution": "Post-support observations are captured and must survive the following query, including the first three support observations.",
      "independent_verification": "negative_control_new_support_deleted_during_query"
    },
    {
      "id": "SEQ-R7",
      "priority": "P1",
      "status": "RESOLVED",
      "title": "Python equality permits typed observation alteration",
      "evidence": "Changing the retained FAIL observed_at_ms from integer 1000000 to floating-point 1000000.0 passed retained_observations and the entire run returned COMPLETED/GREEN.",
      "required_change": "Use canonical typed content equality for retention, including report provenance checks.",
      "resolution": "Retention uses typed canonical content equality and treats malformed payloads as failed retention, rejecting integer/float or boolean/integer substitutions.",
      "independent_verification": "negative_control_retained_numeric_type_changed"
    }
  ],
