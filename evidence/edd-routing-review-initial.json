  "findings": [
    {
      "id": "ROUTE-R1",
      "priority": "P1",
      "status": "OPEN",
      "title": "Publication can discard retained signed evidence",
      "evidence": "After sealed query0, a wrapper around actual record_cost deleted an existing support cost and linked SQLite observation. All32 assigned tasks still completed GREEN because post-publication state replaced prior baselines without a retention comparison.",
      "required_change": "Preserve observations and costs through publication, require exactly the intended new record, and compare before accepting a new baseline."
    },
    {
      "id": "ROUTE-R2",
      "priority": "P1",
      "status": "OPEN",
      "title": "Signed non-independent observation accepted as independent cost evidence",
      "evidence": "verified_costs accepted a trusted-checker-signed observation with independent=false and its signed cost record.",
      "required_change": "Require the exact trusted independent observation contract, not merely a valid checker signature."
    },
    {
      "id": "ROUTE-R3",
      "priority": "P1",
      "status": "OPEN",
      "title": "Procedure can rewrite the host meter trace",
      "evidence": "An adversarial forward procedure made9 actual instrumented catalog reads, then rewrote public catalog.trace to [0]. execute reported1 read and check_reads accepted it.",
      "required_change": "Keep the measurement event sink outside the procedure-writable catalog API. Continue to disclose same-process trust limits."
    },
    {
      "id": "ROUTE-R4",
      "priority": "P1",
      "status": "OPEN",
      "title": "Cost publication lacks an independent exact job binding",
      "evidence": "A cost record re-signed by the trusted checker with a different resource passed verification. This is a misbound-producer probe, not a forged-signature attack; the verifier has no independently registered expected job/candidate direction to compare.",
      "required_change": "Register the expected job, candidate direction and exact resource/catalog/key binding before execution and verify cost publication against it, or explicitly narrow the binding claim."
    }
  ],
