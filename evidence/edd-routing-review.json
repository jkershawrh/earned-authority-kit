  "findings": [
    {
      "id": "ROUTE-R1",
      "priority": "P1",
      "status": "RESOLVED",
      "title": "Publication can discard retained signed evidence",
      "evidence": "After sealed query0, a wrapper around actual record_cost deleted an existing support cost and linked SQLite observation. All32 assigned tasks still completed GREEN because post-publication state replaced prior baselines without a retention comparison.",
      "required_change": "Preserve observations and costs through publication, require exactly the intended new record, and compare before accepting a new baseline.",
      "resolution_title": "Publication retention",
      "observed_resolution": "Actual SQLite deletion of a prior signed support cost and its observation now aborts RED after1 scored query, with all32 assigned queries retained in denominators. Costs, jobs, work, seals and observations are checked across publication before establishing the next baseline."
    },
    {
      "id": "ROUTE-R2",
      "priority": "P1",
      "status": "RESOLVED",
      "title": "Signed non-independent observation accepted as independent cost evidence",
      "evidence": "verified_costs accepted a trusted-checker-signed observation with independent=false and its signed cost record.",
      "required_change": "Require the exact trusted independent observation contract, not merely a valid checker signature.",
      "resolution_title": "Independent observation contract",
      "observed_resolution": "A valid checker signature with independent=false is rejected. Cost evidence additionally requires the exact linked observation and independent registered work."
    },
    {
      "id": "ROUTE-R3",
      "priority": "P1",
      "status": "RESOLVED",
      "title": "Procedure can rewrite the host meter trace",
      "evidence": "An adversarial forward procedure made9 actual instrumented catalog reads, then rewrote public catalog.trace to [0]. execute reported1 read and check_reads accepted it.",
      "required_change": "Keep the measurement event sink outside the procedure-writable catalog API. Continue to disclose same-process trust limits.",
      "resolution_title": "Host-owned meter",
      "observed_resolution": "An adversarial forward procedure reads all9 records and tries to replace catalog.trace; the slotted read view denies replacement, reported reads remain9, and the incorrect directional trace is rejected."
    },
    {
      "id": "ROUTE-R4",
      "priority": "P1",
      "status": "RESOLVED",
      "title": "Cost publication lacks an independent exact job binding",
      "evidence": "A cost record re-signed by the trusted checker with a different resource passed verification. This is a misbound-producer probe, not a forged-signature attack; the verifier has no independently registered expected job/candidate direction to compare.",
      "required_change": "Register the expected job, candidate direction and exact resource/catalog/key binding before execution and verify cost publication against it, or explicitly narrow the binding claim.",
      "resolution_title": "Exact registered job binding",
      "observed_resolution": "Re-signed resource, direction, context, candidate, version, attempt, observation, job/work digest and typed read-count mismatches are rejected against separately signed registered jobs and work receipts. QUERY evidence additionally requires the bound signed seal."
    },
    {
      "id": "ROUTE-R5",
      "status": "RESOLVED",
      "priority": "P1",
      "title": "Report consumer accepts fabricated competitor ineligibility",
      "evidence": "On a valid complete32-query report, changing an unselected candidate qualification from ELIGIBLE to HOLD and removing it from eligible_candidates is accepted, although the durable before_commit qualification remains ELIGIBLE. No re-signing or private key needed.",
      "required_change": "Bind every declared candidate qualification and eligible set to exact captured durable signed qualification and exact subject.",
      "resolution_title": "Complete candidate eligibility audit",
      "observed_resolution": "The consumer checks the complete candidate set, exact qualification objects against durable snapshots, and recomputes subject, disposition, counts, references, freshness, reason and expiry from signed independent observations. Both public-only and public-plus-snapshot fabricated competitor ineligibility now reject."
    }
  ],
