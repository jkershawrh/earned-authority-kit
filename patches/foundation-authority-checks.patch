+func TestAuthorityStillRequiresBindingAndActiveStatus(t *testing.T) {
+	for _, tc := range []struct{ name, field, value string }{
+		{"wrong_agent", "agent_id", "different-agent"},
+		{"revoked", "status", "REVOKED"},
+		{"expired_status", "status", "EXPIRED"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			passport := baseAuthorityPassport()
+			passport[tc.field] = tc.value
+			h := authorityHandler(t, passport)
+			_, result := authorityRequest(t, h, "/v1/passports:verify", map[string]any{"agent_id": "agent", "passport_id": "passport"})
+			if result["verified"] != false {
+				t.Fatalf("verify: %v", result)
+			}
+			_, result = authorityRequest(t, h, "/v1/enforcement/scope:evaluate", map[string]any{"agent_id": "agent", "passport_id": "passport", "action_class": "model.promote", "resource": "model/candidate"})
+			decision, _ := result["decision"].(map[string]any)
+			if decision["effect"] != "DENY" {
+				t.Fatalf("scope: %v", result)
+			}
+		})
+	}
+}
