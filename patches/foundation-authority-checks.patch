+
+func TestPassportMapPreservesZeroScopeExpiry(t *testing.T) {
+	// A zero timestamp in a delegated scope is expired, not an omitted bound.
+	passport := passportToMap(&passportv1.Passport{ScopeSet: []*passportv1.PassportScope{{ExpiresTs: 0}}})
+	scope := passport["scope_set"].([]any)[0].(map[string]any)
+	if got, exists := scope["expires_ts"]; !exists || got != int64(0) {
+		t.Fatalf("delegated expiry lost: %v", scope)
+	}
+}
