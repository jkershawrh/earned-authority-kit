+	code, result := authorityRequest(t, h, "/v1/passports", map[string]any{
+		"agent_id": "agt-authority-test", "passport_type": "STANDARD", "ttl_seconds": 3600, "issued_by": "operator", "reason": "qualification",
+		"requested_scopes": []any{map[string]any{"action_class": "model.promote", "resource_pattern": "model/*", "scope_ttl_seconds": 60, "context_constraints": map[string]any{"site": "A"}}},
+	})
+	if code != http.StatusCreated {
+		t.Fatalf("issue: code=%d result=%v", code, result)
+	}
+	for _, tc := range []struct {
+		name, site, want string
+		offset           time.Duration
+	}{
+		{"qualified_site_before_expiry", "A", "ALLOW", 59 * time.Second},
+		{"other_site", "B", "DENY", 59 * time.Second},
+		{"at_scope_expiry", "A", "DENY", 60 * time.Second},
+		{"after_scope_expiry", "A", "DENY", 61 * time.Second},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			now = authorityCheckTime.Add(tc.offset)
+			code, result := authorityRequest(t, h, "/v1/enforcement/scope:evaluate", map[string]any{"agent_id": "agt-authority-test", "passport_id": "ppt-authority-test", "action_class": "model.promote", "resource": "model/candidate", "context": map[string]any{"site": tc.site}})
+			decision, _ := result["decision"].(map[string]any)
+			if code != http.StatusOK || decision["effect"] != tc.want {
+				t.Errorf("code=%d result=%v want=%s", code, result, tc.want)
+			}
+		})
+	}
+}
+
+func TestAuthorityLocalIssueRejectsMalformedConditions(t *testing.T) {
+	for _, tc := range []struct {
+		name, field string
+		value       any
+	}{
+		{"context_not_object", "context_constraints", "site=A"},
+		{"context_null", "context_constraints", nil},
+		{"context_value_not_string", "context_constraints", map[string]any{"site": 1}},
+		{"scope_ttl_fractional", "scope_ttl_seconds", 1.5},
+		{"scope_ttl_negative", "scope_ttl_seconds", -1},
+		{"scope_ttl_null", "scope_ttl_seconds", nil},
+		{"scope_ttl_overflow", "scope_ttl_seconds", json.Number("9223372036854775808")},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			mem := repo.NewMemory()
+			h, err := Handler(Config{Repo: mem, Now: func() time.Time { return authorityCheckTime }})
+			if err != nil {
+				t.Fatal(err)
+			}
+			code, _ := authorityRequest(t, h, "/v1/identity/agents", map[string]any{"agent_type": "demo", "owner_id": "owner"})
+			if code != http.StatusCreated {
+				t.Fatal(code)
+			}
+			scope := map[string]any{"action_class": "model.promote", "resource_pattern": "model/*", tc.field: tc.value}
+			code, result := authorityRequest(t, h, "/v1/passports", map[string]any{"agent_id": "agt-authority-test", "passport_type": "STANDARD", "ttl_seconds": 3600, "issued_by": "operator", "reason": "qualification", "requested_scopes": []any{scope}})
+			if code != http.StatusBadRequest {
+				t.Fatalf("code=%d result=%v", code, result)
+			}
+			bodies, err := mem.ListPassportBodiesByAgent(context.Background(), "agt-authority-test")
+			if err != nil || len(bodies) != 0 {
+				t.Fatalf("invalid request stored authority: %v %v", bodies, err)
+			}
+		})
+	}
+}
