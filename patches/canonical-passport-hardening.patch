@@ -0,0 +1,140 @@
+package grpc
+
+import (
+	"context"
+	"crypto/ed25519"
+	"crypto/x509"
+	"encoding/json"
+	"encoding/pem"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/srex-dev/agent-passport/internal/local"
+	passportv1 "github.com/srex-dev/agent-passport/proto"
+	ggrpc "google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/credentials/insecure"
+	"google.golang.org/grpc/metadata"
+	"google.golang.org/grpc/status"
+	"google.golang.org/grpc/test/bufconn"
+)
+
+func transportClient(t *testing.T) passportv1.PassportIssuanceServiceClient {
+	t.Helper()
+	registry := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		_, _ = w.Write([]byte(`{"agent":{"agent_id":"agent","status":"ACTIVE"}}`))
+	}))
+	t.Cleanup(registry.Close)
+	dir := t.TempDir()
+	svc, close, err := local.NewDurableService(local.DurableConfig{StatePath: filepath.Join(dir, "state.json"), KeyPath: filepath.Join(dir, "key.pem"), RegistryURL: registry.URL, PolicyID: "p", PolicyVersion: "v1"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = close() })
+	server := ggrpc.NewServer(ggrpc.UnaryInterceptor(MutationTokenInterceptor("test-secret")))
+	passportv1.RegisterPassportIssuanceServiceServer(server, New(svc))
+	listener := bufconn.Listen(1 << 20)
+	go func() { _ = server.Serve(listener) }()
+	t.Cleanup(server.Stop)
+	client, err := ggrpc.NewClient("passthrough:///buffer", ggrpc.WithContextDialer(func(context.Context, string) (net.Conn, error) { return listener.Dial() }), ggrpc.WithTransportCredentials(insecure.NewCredentials()))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = client.Close() })
+	return passportv1.NewPassportIssuanceServiceClient(client)
+}
+func mutationContext(id, revision string) context.Context {
+	return metadata.NewOutgoingContext(context.Background(), metadata.Pairs("authorization", "Bearer test-secret", ExpectedActiveHeader, id, ExpectedRevisionHeader, revision))
+}
+func issueRequest() *passportv1.IssuePassportRequest {
+	return &passportv1.IssuePassportRequest{AgentId: "agent", PassportType: "STANDARD", RequestedScopes: []*passportv1.ScopeRequest{{ActionClass: "WRITE", ResourcePattern: "model/*", ContextConstraints: map[string]string{"site": "A"}, ScopeTtlSeconds: 60}}, TtlSeconds: 300, IssuedBy: "authority", Reason: "qualified"}
+}
+func TestTransportCASAuthorizationAndEmptyRevision(t *testing.T) {
+	client := transportClient(t)
+	var trailer metadata.MD
+	if _, err := client.GetAgentPassport(context.Background(), &passportv1.GetAgentPassportRequest{AgentId: "agent"}, ggrpc.Trailer(&trailer)); status.Code(err) != codes.NotFound || len(trailer.Get(AgentRevisionHeader)) != 1 || trailer.Get(AgentRevisionHeader)[0] != "0" {
+		t.Fatalf("empty revision: trailer=%v err=%v", trailer, err)
+	}
+	if _, err := client.IssuePassport(context.Background(), issueRequest()); status.Code(err) != codes.Unauthenticated {
+		t.Fatal("unauthenticated mutation accepted", err)
+	}
+	tokenOnly := metadata.NewOutgoingContext(context.Background(), metadata.Pairs("authorization", "Bearer test-secret"))
+	if _, err := client.IssuePassport(tokenOnly, issueRequest()); status.Code(err) != codes.FailedPrecondition {
+		t.Fatal("missing CAS accepted", err)
+	}
+	var headers metadata.MD
+	issued, err := client.IssuePassport(mutationContext("none", "0"), issueRequest(), ggrpc.Header(&headers))
+	if err != nil || headers.Get(AgentRevisionHeader)[0] != "1" {
+		t.Fatal("initial issue failed", headers, err)
+	}
+	id := issued.Passport.PassportId
+	payloadValues := headers.Get(CanonicalPayloadHeader)
+	if len(payloadValues) != 1 {
+		t.Fatal("canonical envelope missing", headers)
+	}
+	block, _ := pem.Decode([]byte(issued.Passport.PublicKeyPem))
+	raw, err := x509.ParsePKIXPublicKey(block.Bytes)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !ed25519.Verify(raw.(ed25519.PublicKey), []byte(payloadValues[0]), issued.Passport.Signature) {
+		t.Fatal("transport canonical signature invalid")
+	}
+	verified, err := client.VerifyPassport(context.Background(), &passportv1.VerifyPassportRequest{PassportId: id})
+	if err != nil || !verified.Valid || len(verified.ActiveScopes) != 1 {
+		t.Fatal("stored credential failed verification", verified, err)
+	}
+	forged, err := client.VerifyPassport(context.Background(), &passportv1.VerifyPassportRequest{PassportId: id, Payload: []byte("forged"), Signature: issued.Passport.Signature})
+	if err != nil || forged.Valid {
+		t.Fatal("forged payload verified", forged, err)
+	}
+	for _, ctx := range []context.Context{mutationContext(id, "0"), mutationContext("wrong-id", "1")} {
+		req := issueRequest()
+		req.ForceReissue = true
+		if _, err := client.IssuePassport(ctx, req); status.Code(err) != codes.FailedPrecondition {
+			t.Fatal("cross-field CAS accepted", err)
+		}
+	}
+	_, err = client.RevokePassport(mutationContext(id, "1"), &passportv1.RevokePassportRequest{PassportId: id, Reason: "drift", RevokedBy: "authority"}, ggrpc.Header(&headers))
+	if err != nil || headers.Get(AgentRevisionHeader)[0] != "2" {
+		t.Fatal("revoke failed", headers, err)
+	}
+	if _, err := client.GetAgentPassport(context.Background(), &passportv1.GetAgentPassportRequest{AgentId: "agent"}, ggrpc.Trailer(&trailer)); status.Code(err) != codes.NotFound || trailer.Get(AgentRevisionHeader)[0] != "2" {
+		t.Fatal("empty persisted generation missing", trailer, err)
+	}
+	if _, err := client.IssuePassport(mutationContext("none", "0"), issueRequest()); status.Code(err) != codes.FailedPrecondition {
+		t.Fatal("ABA accepted", err)
+	}
+	if _, err := client.IssuePassport(mutationContext("none", "2"), issueRequest()); err != nil {
+		t.Fatal("reissue with current generation failed", err)
+	}
+	var historical metadata.MD
+	if _, err := client.GetPassport(context.Background(), &passportv1.GetPassportRequest{PassportId: id}, ggrpc.Header(&historical)); err != nil {
+		t.Fatal(err)
+	}
+	var envelope map[string]any
+	if err := json.Unmarshal([]byte(historical.Get(CanonicalPayloadHeader)[0]), &envelope); err != nil {
+		t.Fatal(err)
+	}
+	if envelope["issuance_revision"] != float64(1) || historical.Get(AgentRevisionHeader)[0] != "3" {
+		t.Fatal("historical issuance revision conflated with current generation", envelope, historical)
+	}
+}
+
+func TestTransportRejectsMalformedCASAndNegativeScopeTTL(t *testing.T) {
+	client := transportClient(t)
+	ctx, cancel := context.WithTimeout(mutationContext("none", "not-an-integer"), time.Second)
+	defer cancel()
+	if _, err := client.IssuePassport(ctx, issueRequest()); status.Code(err) != codes.InvalidArgument {
+		t.Fatal("bad revision accepted", err)
+	}
+	req := issueRequest()
+	req.RequestedScopes[0].ScopeTtlSeconds = -1
+	if _, err := client.IssuePassport(mutationContext("none", "0"), req); status.Code(err) != codes.InvalidArgument {
+		t.Fatal("bad TTL accepted", err)
+	}
+}
