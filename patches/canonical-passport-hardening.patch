new file mode 100644
--- /dev/null
+++ b/internal/grpc/authority_metadata.go
@@ -0,0 +1,76 @@
+package grpc
+
+import (
+	"context"
+	"crypto/subtle"
+	"fmt"
+	"github.com/srex-dev/agent-passport/internal/domain"
+	"github.com/srex-dev/agent-passport/internal/service"
+	"strconv"
+	"strings"
+
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/metadata"
+	"google.golang.org/grpc/status"
+)
+
+const ExpectedActiveHeader = "x-are-expected-active-passport-id"
+const ExpectedRevisionHeader = "x-are-expected-agent-revision"
+const AgentRevisionHeader = "x-are-agent-revision"
+
+func expectedActive(ctx context.Context) (*string, error) {
+	values := metadata.ValueFromIncomingContext(ctx, ExpectedActiveHeader)
+	if len(values) == 0 {
+		return nil, nil
+	}
+	if len(values) != 1 || strings.TrimSpace(values[0]) == "" {
+		return nil, status.Error(codes.InvalidArgument, "one nonempty expected active passport is required")
+	}
+	return &values[0], nil
+}
+func expectedRevision(ctx context.Context) (*uint64, error) {
+	values := metadata.ValueFromIncomingContext(ctx, ExpectedRevisionHeader)
+	if len(values) == 0 {
+		return nil, nil
+	}
+	if len(values) != 1 {
+		return nil, status.Error(codes.InvalidArgument, "one expected agent revision is required")
+	}
+	revision, err := strconv.ParseUint(values[0], 10, 64)
+	if err != nil {
+		return nil, status.Error(codes.InvalidArgument, "invalid expected agent revision")
+	}
+	return &revision, nil
+}
+func revisionHeader(ctx context.Context, revision uint64) {
+	_ = grpc.SetHeader(ctx, metadata.Pairs(AgentRevisionHeader, fmt.Sprint(revision)))
+	_ = grpc.SetTrailer(ctx, metadata.Pairs(AgentRevisionHeader, fmt.Sprint(revision)))
+}
+
+// MutationTokenInterceptor protects administrative mutation calls in durable
+// reference mode. Transport security and caller-specific policy remain external.
+func MutationTokenInterceptor(token string) grpc.UnaryServerInterceptor {
+	return func(ctx context.Context, req any, info *grpc.UnaryServerInfo, handler grpc.UnaryHandler) (any, error) {
+		method := info.FullMethod
+		mutation := strings.HasSuffix(method, "/ApplyPassportOperation") || strings.HasSuffix(method, "/GetPassportOperation") || strings.HasSuffix(method, "/IssuePassport") || strings.HasSuffix(method, "/RevokePassport") || strings.HasSuffix(method, "/RenewPassport")
+		if token != "" && mutation {
+			values := metadata.ValueFromIncomingContext(ctx, "authorization")
+			if len(values) != 1 || subtle.ConstantTimeCompare([]byte(values[0]), []byte("Bearer "+token)) != 1 {
+				return nil, status.Error(codes.Unauthenticated, "mutation credential required")
+			}
+		}
+		return handler(ctx, req)
+	}
+}
+
+const CanonicalPayloadHeader = "x-are-canonical-payload-bin"
+
+func canonicalHeader(ctx context.Context, p domain.Passport) {
+	if p.PassportID == "" {
+		return
+	}
+	data := string(service.CanonicalPayload(p))
+	_ = grpc.SetHeader(ctx, metadata.Pairs(CanonicalPayloadHeader, data))
+	_ = grpc.SetTrailer(ctx, metadata.Pairs(CanonicalPayloadHeader, data))
+}
diff --git a/internal/grpc/operations.go b/internal/grpc/operations.go
new file mode 100644
--- /dev/null
+++ b/internal/grpc/operations.go
@@ -0,0 +1,83 @@
+package grpc
+
+import (
+	"context"
+	"github.com/srex-dev/agent-passport/internal/service"
+	pb "github.com/srex-dev/agent-passport/proto"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+func operationReceiptToProto(r service.OperationReceipt) *pb.PassportOperationReceipt {
+	return &pb.PassportOperationReceipt{CanonicalPayload: r.CanonicalPayload, Signature: r.Signature, CredentialId: r.CredentialID, PublicKeyPem: r.PublicKeyPEM}
+}
+func (s *Server) ApplyPassportOperation(ctx context.Context, req *pb.ApplyPassportOperationRequest) (*pb.ApplyPassportOperationResponse, error) {
+	if req == nil || len(req.ProtoReflect().GetUnknown()) != 0 {
+		return nil, status.Error(codes.InvalidArgument, "invalid operation request")
+	}
+	expected, err := expectedActive(ctx)
+	if err != nil {
+		return nil, err
+	}
+	expectedRev, err := expectedRevision(ctx)
+	if err != nil {
+		return nil, err
+	}
+	if expected != nil {
+		value := *expected
+		if value == "none" {
+			value = ""
+		}
+		if value != req.ExpectedActivePassportId {
+			return nil, status.Error(codes.InvalidArgument, "conflicting expected active passport")
+		}
+	}
+	if expectedRev != nil && *expectedRev != req.ExpectedAgentRevision {
+		return nil, status.Error(codes.InvalidArgument, "conflicting expected revision")
+	}
+	request := service.OperationRequest{OperationID: req.OperationId, AgentID: req.AgentId, ExpectedActivePassportID: req.ExpectedActivePassportId, ExpectedAgentRevision: req.ExpectedAgentRevision}
+	switch mutation := req.Mutation.(type) {
+	case *pb.ApplyPassportOperationRequest_Issue:
+		v := mutation.Issue
+		if v == nil || len(v.ProtoReflect().GetUnknown()) != 0 {
+			return nil, status.Error(codes.InvalidArgument, "invalid issue operation")
+		}
+		scopes := make([]service.OperationScope, len(v.RequestedScopes))
+		for i, scope := range v.RequestedScopes {
+			if scope == nil || len(scope.ProtoReflect().GetUnknown()) != 0 {
+				return nil, status.Error(codes.InvalidArgument, "invalid scope operation")
+			}
+			cc := scope.ContextConstraints
+			if cc == nil {
+				cc = map[string]string{}
+			}
+			scopes[i] = service.OperationScope{ActionClass: scope.ActionClass, ResourcePattern: scope.ResourcePattern, ContextConstraints: cc, ScopeTTLSeconds: scope.ScopeTtlSeconds}
+		}
+		request.Action = "ISSUE"
+		request.Issue = &service.OperationIssue{AgentID: v.AgentId, PassportType: v.PassportType, RequestedScopes: scopes, TTLSeconds: v.TtlSeconds, IssuedBy: v.IssuedBy, ForceReissue: v.ForceReissue, Reason: v.Reason}
+	case *pb.ApplyPassportOperationRequest_Revoke:
+		v := mutation.Revoke
+		if v == nil || len(v.ProtoReflect().GetUnknown()) != 0 {
+			return nil, status.Error(codes.InvalidArgument, "invalid revoke operation")
+		}
+		request.Action = "REVOKE"
+		request.Revoke = &service.OperationRevoke{PassportID: v.PassportId, Reason: v.Reason, RevokedBy: v.RevokedBy}
+	default:
+		return nil, status.Error(codes.InvalidArgument, "one mutation required")
+	}
+	receipt, err := s.svc.ApplyOperation(ctx, request)
+	if err != nil {
+		return nil, mapErr(err)
+	}
+	return &pb.ApplyPassportOperationResponse{Receipt: operationReceiptToProto(receipt)}, nil
+}
+func (s *Server) GetPassportOperation(ctx context.Context, req *pb.GetPassportOperationRequest) (*pb.GetPassportOperationResponse, error) {
+	if req == nil || len(req.ProtoReflect().GetUnknown()) != 0 {
+		return nil, status.Error(codes.InvalidArgument, "invalid operation lookup")
+	}
+	receipt, err := s.svc.GetOperation(req.AgentId, req.OperationId)
+	if err != nil {
+		return nil, mapErr(err)
+	}
+	return &pb.GetPassportOperationResponse{Receipt: operationReceiptToProto(receipt)}, nil
+}
