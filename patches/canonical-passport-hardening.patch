@@ -0,0 +1,150 @@
+package service
+
+import (
+	"bytes"
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/srex-dev/agent-passport/internal/domain"
+)
+
+func issueForHardening(t *testing.T, s *Service) domain.Passport {
+	t.Helper()
+	p, err := s.IssuePassport(IssueInput{AgentID: "agent", PassportType: domain.TypeStandard, Scopes: []domain.Scope{scope("WRITE")}, TTLSeconds: 3600, IssuedBy: "authority", Reason: "qualification"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
+
+func TestFailedForceReissueLeavesOriginalActive(t *testing.T) {
+	for _, failure := range []string{"signer", "policy"} {
+		t.Run(failure, func(t *testing.T) {
+			s := New(registryMock{status: AgentActive}, credentialMock{}, ledgerMock{}, outboxMock{})
+			p := issueForHardening(t, s)
+			if failure == "signer" {
+				s.credentials = credentialMock{failSign: true}
+			} else {
+				s.policyBundles = bundleMock{err: errors.New("unavailable")}
+			}
+			_, err := s.IssuePassport(IssueInput{AgentID: "agent", PassportType: domain.TypeStandard, Scopes: []domain.Scope{scope("WRITE")}, TTLSeconds: 3600, IssuedBy: "authority", Reason: "replacement", ForceReissue: true})
+			if !errors.Is(err, ErrUnavailable) {
+				t.Fatalf("error: %v", err)
+			}
+			got, err := s.GetAgentPassport("agent")
+			if err != nil || got.PassportID != p.PassportID || got.Status != domain.StatusActive {
+				t.Fatalf("failed replacement changed authority: %+v %v", got, err)
+			}
+		})
+	}
+}
+
+func TestVerifyRejectsUnrelatedSignedPayload(t *testing.T) {
+	s := New(registryMock{status: AgentActive}, credentialMock{}, nil, outboxMock{})
+	p := issueForHardening(t, s)
+	payload := []byte("unrelated signed message")
+	_, _, sig, _ := s.credentials.Sign(payload)
+	valid, _, _, err := s.VerifyPassport(p.PassportID, payload, sig)
+	if err != nil || valid {
+		t.Fatalf("unrelated payload authorized: valid=%v err=%v", valid, err)
+	}
+}
+
+func TestCanonicalSignatureBindsAuthority(t *testing.T) {
+	cases := []struct {
+		name   string
+		mutate func(*domain.Passport)
+	}{
+		{"credential_id", func(p *domain.Passport) { p.CredentialID = "changed-key" }},
+		{"public_key", func(p *domain.Passport) { p.PublicKeyPEM = "untrusted-key" }},
+		{"revision", func(p *domain.Passport) { p.Revision++ }},
+		{"passport_id", func(p *domain.Passport) { p.PassportID = "changed" }},
+		{"agent_id", func(p *domain.Passport) { p.AgentID = "different-agent" }},
+		{"context", func(p *domain.Passport) { p.ScopeSet[0].ContextConstraints = map[string]string{"site": "B"} }},
+		{"scope_expiry", func(p *domain.Passport) { p.ScopeSet[0].ExpiresTS = p.ScopeSet[0].ExpiresTS.Add(time.Hour) }},
+		{"scope_grant", func(p *domain.Passport) { p.ScopeSet[0].GrantedTS = p.ScopeSet[0].GrantedTS.Add(-time.Hour) }},
+		{"escalation", func(p *domain.Passport) { p.ScopeSet[0].IsEscalation = true }},
+		{"policy_id", func(p *domain.Passport) { p.PolicyIDAtIssuance = "different-policy" }},
+		{"policy_version", func(p *domain.Passport) { p.PolicyVerAtIssuance = "999" }},
+		{"issuer", func(p *domain.Passport) { p.IssuedBy = "different-authority" }},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			s := New(registryMock{status: AgentActive}, credentialMock{}, nil, outboxMock{})
+			p := issueForHardening(t, s)
+			payload := bytes.TrimPrefix(p.Signature, []byte("sig:"))
+			altered := s.passports[p.PassportID]
+			tc.mutate(&altered)
+			s.passports[p.PassportID] = altered
+			valid, _, _, err := s.VerifyPassport(p.PassportID, payload, p.Signature)
+			if err != nil || valid {
+				t.Fatalf("tampered authority authorized: %v %v", valid, err)
+			}
+		})
+	}
+}
+
+func TestReturnedRecordsDoNotMutateAuthority(t *testing.T) {
+	s := New(registryMock{status: AgentActive}, credentialMock{}, nil, outboxMock{})
+	p := issueForHardening(t, s)
+	p.ScopeSet[0].ResourcePattern = "unbounded/*"
+	got, _ := s.GetPassport(p.PassportID)
+	if got.ScopeSet[0].ResourcePattern == "unbounded/*" {
+		t.Fatal("issuer return aliases stored authority")
+	}
+	got.ScopeSet[0].ContextConstraints = map[string]string{"site": "A"}
+	got.ScopeSet[0].ResourcePattern = "mutated/*"
+	again, _ := s.GetPassport(p.PassportID)
+	if again.ScopeSet[0].ResourcePattern == "mutated/*" {
+		t.Fatal("getter return aliases stored authority")
+	}
+}
+
+func TestVerificationChecksCurrentIdentityAndActivePointer(t *testing.T) {
+	for _, change := range []string{"suspended", "deregistered", "not_active_pointer"} {
+		t.Run(change, func(t *testing.T) {
+			s := New(registryMock{status: AgentActive}, credentialMock{}, nil, outboxMock{})
+			p := issueForHardening(t, s)
+			payload := bytes.TrimPrefix(p.Signature, []byte("sig:"))
+			if change == "suspended" {
+				s.registry = registryMock{status: AgentSuspended}
+			} else if change == "deregistered" {
+				s.registry = registryMock{status: AgentDeregistered}
+			} else {
+				delete(s.activeByAgent, p.AgentID)
+			}
+			valid, _, _, err := s.VerifyPassport(p.PassportID, payload, p.Signature)
+			if err != nil || valid {
+				t.Fatalf("inactive identity/authority authorized: %v %v", valid, err)
+			}
+		})
+	}
+}
+
+func TestExpiryBoundaryAndSignatureIsolation(t *testing.T) {
+	s := New(registryMock{status: AgentActive}, credentialMock{}, nil, nil)
+	now := time.Now().UTC()
+	s.now = func() time.Time { return now }
+	input := IssueInput{AgentID: "agent", PassportType: domain.TypeStandard, Scopes: []domain.Scope{{ScopeID: "scope", ActionClass: "WRITE", ResourcePattern: "model/*", GrantedTS: now, ExpiresTS: now.Add(time.Hour), ContextConstraints: map[string]string{"site": "A"}}}, TTLSeconds: 3600, IssuedBy: "authority", Reason: "qualified"}
+	p, err := s.IssuePassport(input)
+	if err != nil {
+		t.Fatal(err)
+	}
+	input.Scopes[0].ContextConstraints["site"] = "outside"
+	p.ScopeSet[0].ContextConstraints["site"] = "outside"
+	p.Signature[0] ^= 0xff
+	stored, _ := s.GetPassport(p.PassportID)
+	if stored.ScopeSet[0].ContextConstraints["site"] != "A" {
+		t.Fatal("context map aliases authority")
+	}
+	valid, _, _, err := s.VerifyPassport(p.PassportID, nil, nil)
+	if err != nil || !valid {
+		t.Fatal("external signature mutation corrupted record", err)
+	}
+	now = stored.ExpiresTS
+	valid, status, reason, err := s.VerifyPassport(p.PassportID, nil, nil)
+	if err != nil || valid || status != domain.StatusExpired || reason != "expired" {
+		t.Fatal("expiry boundary accepted", valid, status, reason, err)
+	}
+}
diff --git a/internal/service/persistence.go b/internal/service/persistence.go
new file mode 100644
--- /dev/null
+++ b/internal/service/persistence.go
@@ -0,0 +1,90 @@
+package service
+
+import (
+	"errors"
+	"fmt"
+	"github.com/srex-dev/agent-passport/internal/domain"
+)
+
+// State is one atomically replaced single-writer snapshot. It is not a
+// distributed database and does not provide anti-rollback against its owner.
+type State struct {
+	Version       int                        `json:"version"`
+	Passports     map[string]domain.Passport `json:"passports"`
+	ActiveByAgent map[string]string          `json:"active_by_agent"`
+	Revisions     map[string]uint64          `json:"revisions"`
+}
+type StateStore interface {
+	Load() (State, error)
+	Save(State) error
+}
+
+// ErrCommitUnknown means rename succeeded but durability could not be confirmed.
+// The service stops serving until restarted from the durable snapshot.
+var ErrCommitUnknown = errors.New("commit outcome unknown")
+
+func NewPersistent(registry AgentRegistryClient, credentials CredentialStoreClient, ledger LedgerClient, outbox OutboxWriter, bundles PolicyBundleRegistryClient, store StateStore, fencePath string) (*Service, error) {
+	if registry == nil || credentials == nil || store == nil {
+		return nil, ErrInvalidArgument
+	}
+	s := New(registry, credentials, ledger, outbox, bundles)
+	s.store = store
+	s.requireCAS = true
+	s.fencePath = fencePath
+	state, err := store.Load()
+	if err != nil {
+		return nil, err
+	}
+	if state.Version != 1 || state.Passports == nil || state.ActiveByAgent == nil || state.Revisions == nil {
+		return nil, fmt.Errorf("invalid persisted state")
+	}
+	for id, p := range state.Passports {
+		if id != p.PassportID || p.AgentID == "" || p.Revision == 0 || state.Revisions[p.AgentID] < p.Revision {
+			return nil, fmt.Errorf("invalid persisted identity/revision")
+		}
+		valid, err := credentials.Verify(p.PublicKeyPEM, CanonicalPayload(p), p.Signature)
+		if err != nil || !valid {
+			return nil, fmt.Errorf("persisted signature invalid for passport %s", id)
+		}
+		if p.Status == domain.StatusActive && state.ActiveByAgent[p.AgentID] != id {
+			return nil, fmt.Errorf("unindexed active passport")
+		}
+	}
+	for agent, id := range state.ActiveByAgent {
+		p, ok := state.Passports[id]
+		if !ok || p.AgentID != agent || p.Status != domain.StatusActive || p.Revision != state.Revisions[agent] {
+			return nil, fmt.Errorf("invalid active passport index")
+		}
+	}
+	s.passports = state.Passports
+	s.activeByAgent = state.ActiveByAgent
+	s.revisions = state.Revisions
+	return s, nil
+}
+func (s *Service) snapshot() State {
+	state := State{Version: 1, Passports: make(map[string]domain.Passport, len(s.passports)), ActiveByAgent: make(map[string]string, len(s.activeByAgent)), Revisions: make(map[string]uint64, len(s.revisions))}
+	for k, v := range s.passports {
+		state.Passports[k] = clonePassport(v)
+	}
+	for k, v := range s.activeByAgent {
+		state.ActiveByAgent[k] = v
+	}
+	for k, v := range s.revisions {
+		state.Revisions[k] = v
+	}
+	return state
+}
+func (s *Service) commit(next State) error {
+	if s.store != nil {
+		if err := s.store.Save(next); err != nil {
+			if errors.Is(err, ErrCommitUnknown) {
+				s.poisoned = true
+			}
+			return fmt.Errorf("%w: persistence: %v", ErrUnavailable, err)
+		}
+	}
+	s.passports = next.Passports
+	s.activeByAgent = next.ActiveByAgent
+	s.revisions = next.Revisions
+	return nil
+}
diff --git a/internal/service/persistence_test.go b/internal/service/persistence_test.go
new file mode 100644
--- /dev/null
+++ b/internal/service/persistence_test.go
@@ -0,0 +1,211 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"path/filepath"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/srex-dev/agent-passport/internal/domain"
+)
+
+type testStateStore struct {
+	state State
+	err   error
+}
+
+func newTestStateStore() *testStateStore {
+	return &testStateStore{state: State{Version: 1, Passports: map[string]domain.Passport{}, ActiveByAgent: map[string]string{}, Revisions: map[string]uint64{}}}
+}
+func (m *testStateStore) Load() (State, error) { return m.state, nil }
+func (m *testStateStore) Save(s State) error {
+	if m.err != nil {
+		return m.err
+	}
+	m.state = s
+	return nil
+}
+func expectedID(s string) *string  { return &s }
+func expectedRev(n uint64) *uint64 { return &n }
+func persistentIssue(expected string, revision uint64) IssueInput {
+	return IssueInput{AgentID: "agent", PassportType: domain.TypeStandard, Scopes: []domain.Scope{scope("WRITE")}, TTLSeconds: 3600, IssuedBy: "authority", Reason: "qualification", ExpectedActivePassportID: expectedID(expected), ExpectedAgentRevision: expectedRev(revision)}
+}
+func testPersistent(t *testing.T, store StateStore, fence string) *Service {
+	t.Helper()
+	s, err := NewPersistent(registryMock{status: AgentActive}, credentialMock{}, nil, nil, bundleMock{id: "policy", ver: "1"}, store, fence)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return s
+}
+
+func TestPersistenceFailureIsAtomic(t *testing.T) {
+	store := newTestStateStore()
+	s := testPersistent(t, store, "")
+	first, err := s.IssuePassport(persistentIssue("none", 0))
+	if err != nil {
+		t.Fatal(err)
+	}
+	store.err = errors.New("disk full")
+	replacement := persistentIssue(first.PassportID, 1)
+	replacement.ForceReissue = true
+	if _, err = s.IssuePassport(replacement); !errors.Is(err, ErrUnavailable) {
+		t.Fatal(err)
+	}
+	active, rev, err := s.GetAgentPassportRevision("agent")
+	if err != nil || active.PassportID != first.PassportID || active.Status != domain.StatusActive || rev != 1 {
+		t.Fatalf("replacement changed state: %+v %d %v", active, rev, err)
+	}
+	if _, _, err = s.RevokePassportConditional(context.Background(), first.PassportID, "drift", "authority", expectedID(first.PassportID), expectedRev(1)); !errors.Is(err, ErrUnavailable) {
+		t.Fatal(err)
+	}
+	active, rev, err = s.GetAgentPassportRevision("agent")
+	if err != nil || active.Status != domain.StatusActive || rev != 1 {
+		t.Fatalf("revoke changed state: %+v %d %v", active, rev, err)
+	}
+}
+
+func TestUnknownCommitFailsClosedUntilRestart(t *testing.T) {
+	store := newTestStateStore()
+	s := testPersistent(t, store, "")
+	store.err = ErrCommitUnknown
+	if _, err := s.IssuePassport(persistentIssue("none", 0)); !errors.Is(err, ErrUnavailable) {
+		t.Fatal(err)
+	}
+	if _, _, err := s.GetAgentPassportRevision("agent"); !errors.Is(err, ErrUnavailable) {
+		t.Fatal("uncertain store remained readable", err)
+	}
+	store.err = nil
+	if _, err := s.IssuePassport(persistentIssue("none", 0)); !errors.Is(err, ErrUnavailable) {
+		t.Fatal("uncertain service resumed mutations", err)
+	}
+}
+
+func TestCASRequiresBothFieldsAndRejectsCrossFieldMismatch(t *testing.T) {
+	s := testPersistent(t, newTestStateStore(), "")
+	for _, missing := range []string{"id", "revision"} {
+		in := persistentIssue("none", 0)
+		if missing == "id" {
+			in.ExpectedActivePassportID = nil
+		} else {
+			in.ExpectedAgentRevision = nil
+		}
+		if _, err := s.IssuePassport(in); !errors.Is(err, ErrFailedPrecondition) {
+			t.Fatalf("missing %s: %v", missing, err)
+		}
+	}
+	p, err := s.IssuePassport(persistentIssue("none", 0))
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, in := range []IssueInput{persistentIssue("wrong-id", 1), persistentIssue(p.PassportID, 0)} {
+		in.ForceReissue = true
+		if _, err := s.IssuePassport(in); !errors.Is(err, ErrFailedPrecondition) {
+			t.Fatal(err)
+		}
+	}
+	_, rev, err := s.RevokePassportConditional(context.Background(), p.PassportID, "drift", "authority", expectedID(p.PassportID), expectedRev(1))
+	if err != nil || rev != 2 {
+		t.Fatalf("revoke rev=%d err=%v", rev, err)
+	}
+	if _, err := s.IssuePassport(persistentIssue("none", 0)); !errors.Is(err, ErrFailedPrecondition) {
+		t.Fatal("empty-state ABA authorized", err)
+	}
+	p, err = s.IssuePassport(persistentIssue("none", 2))
+	if err != nil || p.Revision != 3 {
+		t.Fatalf("fresh empty CAS failed: %+v %v", p, err)
+	}
+}
+
+func TestConcurrentCASHasSingleWinner(t *testing.T) {
+	s := testPersistent(t, newTestStateStore(), "")
+	var wg sync.WaitGroup
+	results := make(chan error, 16)
+	for i := 0; i < 16; i++ {
+		wg.Add(1)
+		go func() { defer wg.Done(); _, err := s.IssuePassport(persistentIssue("none", 0)); results <- err }()
+	}
+	wg.Wait()
+	close(results)
+	winners := 0
+	for err := range results {
+		if err == nil {
+			winners++
+		} else if !errors.Is(err, ErrFailedPrecondition) {
+			t.Fatal(err)
+		}
+	}
+	if winners != 1 {
+		t.Fatalf("CAS winners=%d", winners)
+	}
+}
+
+func TestFenceBlocksMutationButNotReadsAndHonorsCancellation(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "authority.fence")
+	s := testPersistent(t, newTestStateStore(), path)
+	p, err := s.IssuePassport(persistentIssue("none", 0))
+	if err != nil {
+		t.Fatal(err)
+	}
+	unlock, err := acquireFence(context.Background(), path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unlock()
+	ctx, cancel := context.WithTimeout(context.Background(), 100*time.Millisecond)
+	defer cancel()
+	result := make(chan error, 1)
+	go func() {
+		_, _, err := s.RevokePassportConditional(ctx, p.PassportID, "drift", "authority", expectedID(p.PassportID), expectedRev(1))
+		result <- err
+	}()
+	active, rev, err := s.GetAgentPassportRevision("agent")
+	if err != nil || active.PassportID != p.PassportID || rev != 1 {
+		t.Fatalf("fenced read failed: %+v %d %v", active, rev, err)
+	}
+	select {
+	case err := <-result:
+		if !errors.Is(err, ErrUnavailable) {
+			t.Fatal(err)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("mutation deadlocked instead of observing context")
+	}
+	active, _, _ = s.GetAgentPassportRevision("agent")
+	if active.Status != domain.StatusActive {
+		t.Fatal("canceled fenced mutation applied")
+	}
+}
