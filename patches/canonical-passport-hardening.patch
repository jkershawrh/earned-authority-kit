@@ -0,0 +1,59 @@
+package service
+
+import (
+	"bytes"
+	"crypto/ed25519"
+	"crypto/x509"
+	"encoding/base64"
+	"encoding/json"
+	"encoding/pem"
+	"os"
+	"testing"
+)
+
+func TestOperationCanonicalInteroperabilityVectors(t *testing.T) {
+	raw, err := os.ReadFile("testdata/operations-v1.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var fixture struct {
+		Cases []struct {
+			Request          OperationRequest `json:"request"`
+			CanonicalRequest string           `json:"request_canonical_utf8"`
+			Payload          string           `json:"canonical_payload_base64"`
+			Signature        string           `json:"signature_base64"`
+			PublicKey        string           `json:"public_key_pem"`
+		} `json:"cases"`
+	}
+	if err = json.Unmarshal(raw, &fixture); err != nil {
+		t.Fatal(err)
+	}
+	for _, v := range fixture.Cases {
+		t.Run(v.Request.Action, func(t *testing.T) {
+			if string(CanonicalOperationRequest(v.Request)) != v.CanonicalRequest {
+				t.Fatal("request encoding drift")
+			}
+			payload, _ := base64.StdEncoding.DecodeString(v.Payload)
+			signature, _ := base64.StdEncoding.DecodeString(v.Signature)
+			var p OperationPayload
+			if err = json.Unmarshal(payload, &p); err != nil {
+				t.Fatal(err)
+			}
+			encoded, _ := json.Marshal(p)
+			if !bytes.Equal(encoded, payload) {
+				t.Fatal("receipt encoding drift")
+			}
+			if p.RequestDigest != operationDigest(v.Request) {
+				t.Fatal("request digest mismatch")
+			}
+			block, _ := pem.Decode([]byte(v.PublicKey))
+			key, err := x509.ParsePKIXPublicKey(block.Bytes)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !ed25519.Verify(key.(ed25519.PublicKey), payload, signature) {
+				t.Fatal("receipt signature mismatch")
+			}
+		})
+	}
+}
diff --git a/internal/service/operations.go b/internal/service/operations.go
new file mode 100644
--- /dev/null
+++ b/internal/service/operations.go
@@ -0,0 +1,281 @@
+package service
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"fmt"
+	"github.com/google/uuid"
+	"github.com/srex-dev/agent-passport/internal/domain"
+	"io"
+	"regexp"
+	"time"
+)
+
+type OperationScope struct {
+	ActionClass        string            `json:"action_class"`
+	ResourcePattern    string            `json:"resource_pattern"`
+	ContextConstraints map[string]string `json:"context_constraints"`
+	ScopeTTLSeconds    int64             `json:"scope_ttl_seconds"`
+}
+type OperationIssue struct {
+	AgentID         string           `json:"agent_id"`
+	PassportType    string           `json:"passport_type"`
+	RequestedScopes []OperationScope `json:"requested_scopes"`
+	TTLSeconds      int64            `json:"ttl_seconds"`
+	IssuedBy        string           `json:"issued_by"`
+	ForceReissue    bool             `json:"force_reissue"`
+	Reason          string           `json:"reason"`
+}
+type OperationRevoke struct {
+	PassportID string `json:"passport_id"`
+	Reason     string `json:"reason"`
+	RevokedBy  string `json:"revoked_by"`
+}
+type OperationRequest struct {
+	OperationID              string           `json:"operation_id"`
+	AgentID                  string           `json:"agent_id"`
+	Action                   string           `json:"action"`
+	ExpectedActivePassportID string           `json:"expected_active_passport_id"`
+	ExpectedAgentRevision    uint64           `json:"expected_agent_revision"`
+	Issue                    *OperationIssue  `json:"issue"`
+	Revoke                   *OperationRevoke `json:"revoke"`
+}
+type OperationResult struct {
+	Action                    string `json:"action"`
+	PassportID                string `json:"passport_id"`
+	Status                    string `json:"status"`
+	CompletedTS               int64  `json:"completed_ts"`
+	PassportPayload           []byte `json:"passport_payload_base64"`
+	PassportSignature         []byte `json:"passport_signature_base64"`
+	PreviousPassportPayload   []byte `json:"previous_passport_payload_base64"`
+	PreviousPassportSignature []byte `json:"previous_passport_signature_base64"`
+}
+type OperationPayload struct {
+	CanonicalVersion         string           `json:"canonical_version"`
+	CredentialID             string           `json:"credential_id"`
+	PublicKeyPEM             string           `json:"public_key_pem"`
+	OperationID              string           `json:"operation_id"`
+	AgentID                  string           `json:"agent_id"`
+	Request                  OperationRequest `json:"request"`
+	RequestDigest            string           `json:"request_digest"`
+	AgentRevision            uint64           `json:"agent_revision"`
+	PreviousActivePassportID string           `json:"previous_active_passport_id"`
+	ActivePassportID         string           `json:"active_passport_id"`
+	Result                   OperationResult  `json:"result"`
+}
+type OperationReceipt struct {
+	CanonicalPayload []byte `json:"canonical_payload"`
+	Signature        []byte `json:"signature"`
+	CredentialID     string `json:"credential_id"`
+	PublicKeyPEM     string `json:"public_key_pem"`
+}
+
+func (r OperationReceipt) Payload() OperationPayload {
+	var p OperationPayload
+	_ = json.Unmarshal(r.CanonicalPayload, &p)
+	return p
+}
+
+var operationIDPattern = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$`)
+
+// CanonicalOperationRequest uses sorted JSON keys, integer values, ordered scope
+// arrays and Go JSON escaping. No timestamps or generated scope IDs enter it.
+func CanonicalOperationRequest(r OperationRequest) []byte {
+	raw, _ := json.Marshal(r)
+	d := json.NewDecoder(bytes.NewReader(raw))
+	d.UseNumber()
+	var object any
+	_ = d.Decode(&object)
+	result, _ := json.Marshal(object)
+	return result
+}
+func operationDigest(r OperationRequest) string {
+	return fmt.Sprintf("sha256:%x", sha256.Sum256(CanonicalOperationRequest(r)))
+}
+func cloneReceipt(r OperationReceipt) OperationReceipt {
+	r.CanonicalPayload = append([]byte(nil), r.CanonicalPayload...)
+	r.Signature = append([]byte(nil), r.Signature...)
+	return r
+}
+func normalizedOperation(r OperationRequest) (OperationRequest, error) {
+	raw, err := json.Marshal(r)
+	if err != nil {
+		return r, ErrInvalidArgument
+	}
+	var out OperationRequest
+	if err = json.Unmarshal(raw, &out); err != nil {
+		return out, ErrInvalidArgument
+	}
+	if !operationIDPattern.MatchString(out.OperationID) || out.AgentID == "" || out.ExpectedActivePassportID == "none" {
+		return out, ErrInvalidArgument
+	}
+	switch out.Action {
+	case "ISSUE":
+		if out.Issue == nil || out.Revoke != nil || out.Issue.AgentID != out.AgentID {
+			return out, ErrInvalidArgument
+		}
+		if out.Issue.PassportType != "STANDARD" && out.Issue.PassportType != "PROVISIONAL" {
+			return out, ErrInvalidArgument
+		}
+		for i := range out.Issue.RequestedScopes {
+			scope := &out.Issue.RequestedScopes[i]
+			if scope.ActionClass == "" || scope.ResourcePattern == "" || scope.ScopeTTLSeconds < 0 {
+				return out, ErrInvalidArgument
+			}
+			if scope.ContextConstraints == nil {
+				scope.ContextConstraints = map[string]string{}
+			}
+		}
+	case "REVOKE":
+		if out.Revoke == nil || out.Issue != nil || out.Revoke.PassportID == "" || out.Revoke.PassportID != out.ExpectedActivePassportID || out.Revoke.Reason == "" || out.Revoke.RevokedBy == "" {
+			return out, ErrInvalidArgument
+		}
+	default:
+		return out, ErrInvalidArgument
+	}
+	return out, nil
+}
+
+func (s *Service) ApplyOperation(ctx context.Context, request OperationRequest) (OperationReceipt, error) {
+	request, err := normalizedOperation(request)
+	if err != nil {
+		return OperationReceipt{}, err
+	}
+	unlock, err := acquireFence(ctx, s.fencePath)
+	if err != nil {
+		return OperationReceipt{}, fmt.Errorf("%w: fence: %v", ErrUnavailable, err)
+	}
+	defer unlock()
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if err = s.checkMutable(); err != nil {
+		return OperationReceipt{}, err
+	}
+	if existing, ok := s.operations[request.OperationID]; ok {
+		if !bytes.Equal(CanonicalOperationRequest(existing.Payload().Request), CanonicalOperationRequest(request)) {
+			return OperationReceipt{}, ErrOperationConflict
+		}
+		return cloneReceipt(existing), nil
+	}
+	if err = s.checkCAS(request.AgentID, &request.ExpectedActivePassportID, &request.ExpectedAgentRevision); err != nil {
+		return OperationReceipt{}, err
+	}
+	if request.Action == "ISSUE" {
+		in := request.Issue
+		now := s.now().UTC().Truncate(time.Millisecond)
+		scopes := make([]domain.Scope, len(in.RequestedScopes))
+		for i, scope := range in.RequestedScopes {
+			ttl := scope.ScopeTTLSeconds
+			if ttl == 0 || ttl > in.TTLSeconds {
+				ttl = in.TTLSeconds
+			}
+			// Bounds are validated before conversion to time.Duration to prevent overflow.
+			if ttl < 1 || ttl > 2592000 {
+				return OperationReceipt{}, ErrInvalidArgument
+			}
+			scopes[i] = domain.Scope{ScopeID: uuid.NewString(), ActionClass: scope.ActionClass, ResourcePattern: scope.ResourcePattern, ContextConstraints: scope.ContextConstraints, GrantedTS: now, ExpiresTS: now.Add(time.Duration(ttl) * time.Second)}
+		}
+		input := IssueInput{AgentID: in.AgentID, PassportType: domain.PassportType(in.PassportType), Scopes: scopes, TTLSeconds: in.TTLSeconds, IssuedBy: in.IssuedBy, ForceReissue: in.ForceReissue, Reason: in.Reason, ExpectedActivePassportID: &request.ExpectedActivePassportID, ExpectedAgentRevision: &request.ExpectedAgentRevision}
+		if err = s.validateIssueInput(input); err != nil {
+			return OperationReceipt{}, err
+		}
+		if _, err = s.issueLocked(ctx, input, &request); err != nil {
+			return OperationReceipt{}, err
+		}
+	} else {
+		p, ok := s.passports[request.Revoke.PassportID]
+		if !ok || p.AgentID != request.AgentID || p.Status != domain.StatusActive || s.activeByAgent[request.AgentID] != p.PassportID {
+			return OperationReceipt{}, ErrFailedPrecondition
+		}
+		if _, _, err = s.revokeLocked(ctx, p.PassportID, request.Revoke.Reason, request.Revoke.RevokedBy, &request.ExpectedActivePassportID, &request.ExpectedAgentRevision, &request); err != nil {
+			return OperationReceipt{}, err
+		}
+	}
+	return cloneReceipt(s.operations[request.OperationID]), nil
+}
+
+func (s *Service) GetOperation(agentID, operationID string) (OperationReceipt, error) {
+	if agentID == "" || !operationIDPattern.MatchString(operationID) {
+		return OperationReceipt{}, ErrInvalidArgument
+	}
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	if s.poisoned {
+		return OperationReceipt{}, ErrUnavailable
+	}
+	receipt, ok := s.operations[operationID]
+	if !ok || receipt.Payload().AgentID != agentID {
+		return OperationReceipt{}, ErrNotFound
+	}
+	return cloneReceipt(receipt), nil
+}
+
+func (s *Service) makeOperationReceipt(request OperationRequest, p domain.Passport, revision uint64, previousID, activeID string, now time.Time) (OperationReceipt, error) {
+	result := OperationResult{Action: request.Action, PassportID: p.PassportID, Status: string(p.Status), CompletedTS: now.UnixMilli(), PassportPayload: CanonicalPayload(p), PassportSignature: append([]byte(nil), p.Signature...), PreviousPassportPayload: []byte{}, PreviousPassportSignature: []byte{}}
+	if previousID != "" {
+		old := s.passports[previousID]
+		result.PreviousPassportPayload = CanonicalPayload(old)
+		result.PreviousPassportSignature = append([]byte(nil), old.Signature...)
+	}
+	var credentialID, publicKey string
+	var err error
+	if identity, ok := s.credentials.(SigningIdentity); ok {
+		credentialID, publicKey, err = identity.Identity()
+	} else {
+		credentialID, publicKey, _, err = s.credentials.Sign(nil)
+	}
+	if err != nil {
+		return OperationReceipt{}, ErrUnavailable
+	}
+	payload := OperationPayload{CanonicalVersion: "are.passport.operation.v1", CredentialID: credentialID, PublicKeyPEM: publicKey, OperationID: request.OperationID, AgentID: request.AgentID, Request: request, RequestDigest: operationDigest(request), AgentRevision: revision, PreviousActivePassportID: previousID, ActivePassportID: activeID, Result: result}
+	raw, _ := json.Marshal(payload)
+	id, key, signature, err := s.credentials.Sign(raw)
+	if err != nil || id != credentialID || key != publicKey {
+		return OperationReceipt{}, ErrUnavailable
+	}
+	return OperationReceipt{CanonicalPayload: raw, Signature: signature, CredentialID: id, PublicKeyPEM: key}, nil
+}
+
+func (s *Service) validateStoredOperation(id string, r OperationReceipt, state State) error {
+	var payload OperationPayload
+	d := json.NewDecoder(bytes.NewReader(r.CanonicalPayload))
+	d.DisallowUnknownFields()
+	if err := d.Decode(&payload); err != nil {
+		return fmt.Errorf("invalid operation payload: %w", err)
+	}
+	var extra any
+	if err := d.Decode(&extra); err != io.EOF {
+		return fmt.Errorf("invalid operation payload trailer")
+	}
+	canonical, _ := json.Marshal(payload)
+	valid, err := s.credentials.Verify(r.PublicKeyPEM, r.CanonicalPayload, r.Signature)
+	if err != nil || !valid || !bytes.Equal(canonical, r.CanonicalPayload) || payload.CredentialID != r.CredentialID || payload.PublicKeyPEM != r.PublicKeyPEM {
+		return fmt.Errorf("invalid persisted operation signature")
+	}
+	request, err := normalizedOperation(payload.Request)
+	if err != nil || payload.CanonicalVersion != "are.passport.operation.v1" || id != payload.OperationID || id != request.OperationID || payload.AgentID != request.AgentID || payload.RequestDigest != operationDigest(request) || payload.AgentRevision != request.ExpectedAgentRevision+1 || payload.AgentRevision == 0 || payload.AgentRevision > state.Revisions[payload.AgentID] || payload.PreviousActivePassportID != request.ExpectedActivePassportID {
+		return fmt.Errorf("invalid persisted operation binding")
+	}
+	p, ok := state.Passports[payload.Result.PassportID]
+	if !ok || p.AgentID != payload.AgentID || !bytes.Equal(CanonicalPayload(p), payload.Result.PassportPayload) || !bytes.Equal(p.Signature, payload.Result.PassportSignature) || payload.Result.Action != request.Action || payload.Result.CompletedTS <= 0 {
+		return fmt.Errorf("invalid operation result binding")
+	}
+	if request.Action == "ISSUE" {
+		if payload.Result.Status != "ACTIVE" || payload.ActivePassportID != p.PassportID || p.Revision != payload.AgentRevision {
+			return fmt.Errorf("invalid issue operation result")
+		}
+	} else if payload.Result.Status != "REVOKED" || payload.ActivePassportID != "" || p.PassportID != request.Revoke.PassportID || p.Revision >= payload.AgentRevision {
+		return fmt.Errorf("invalid revoke operation result")
+	}
+	if payload.PreviousActivePassportID != "" {
+		old, ok := state.Passports[payload.PreviousActivePassportID]
+		if !ok || old.AgentID != payload.AgentID || !bytes.Equal(CanonicalPayload(old), payload.Result.PreviousPassportPayload) || !bytes.Equal(old.Signature, payload.Result.PreviousPassportSignature) {
+			return fmt.Errorf("invalid previous operation artifact")
+		}
+	} else if len(payload.Result.PreviousPassportPayload) != 0 || len(payload.Result.PreviousPassportSignature) != 0 {
+		return fmt.Errorf("unexpected previous operation artifact")
+	}
+	return nil
+}
diff --git a/internal/service/operations_test.go b/internal/service/operations_test.go
new file mode 100644
--- /dev/null
+++ b/internal/service/operations_test.go
@@ -0,0 +1,334 @@
+package service
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"github.com/srex-dev/agent-passport/internal/domain"
+	"os"
+	"path/filepath"
+	"sync"
+	"testing"
+	"time"
+)
+
+func issueOperation(id, expected string, revision uint64) OperationRequest {
+	return OperationRequest{OperationID: id, AgentID: "agent", Action: "ISSUE", ExpectedActivePassportID: expected, ExpectedAgentRevision: revision,
+		Issue: &OperationIssue{AgentID: "agent", PassportType: "STANDARD", TTLSeconds: 300, IssuedBy: "authority", Reason: "qualified <>& 世界", ForceReissue: expected != "", RequestedScopes: []OperationScope{{ActionClass: "WRITE", ResourcePattern: "model/*", ContextConstraints: map[string]string{"site": "A"}, ScopeTTLSeconds: 60}}}}
+}
+func applyOperation(t *testing.T, s *Service, r OperationRequest) OperationReceipt {
+	t.Helper()
+	got, err := s.ApplyOperation(context.Background(), r)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return got
+}
+func TestOperationRetrySurvivesRestartAndReplacement(t *testing.T) {
+	store := newTestStateStore()
+	s := testPersistent(t, store, "")
+	request := issueOperation("op1", "", 0)
+	first := applyOperation(t, s, request)
+	p := first.Payload()
+	if p.AgentRevision != 1 || p.Request.OperationID != "op1" {
+		t.Fatalf("receipt %+v", p)
+	}
+	applyOperation(t, s, issueOperation("op2", p.ActivePassportID, 1))
+	s = testPersistent(t, store, "")
+	s.registry = registryMock{status: AgentSuspended}
+	s.now = func() time.Time { return time.Now().Add(48 * time.Hour) }
+	retry := applyOperation(t, s, request)
+	if !bytes.Equal(first.CanonicalPayload, retry.CanonicalPayload) || !bytes.Equal(first.Signature, retry.Signature) {
+		t.Fatal("retry changed receipt")
+	}
+	found, err := s.GetOperation("agent", "op1")
+	if err != nil || !bytes.Equal(found.CanonicalPayload, first.CanonicalPayload) {
+		t.Fatal("historical lookup missing", err)
+	}
+	_, revision, _ := s.GetAgentPassportRevision("agent")
+	if revision != 2 {
+		t.Fatal("replay advanced revision", revision)
+	}
+}
+func TestOperationIDRejectsDifferentSubjectAndBody(t *testing.T) {
+	s := testPersistent(t, newTestStateStore(), "")
+	original := issueOperation("same", "", 0)
+	applyOperation(t, s, original)
+	for _, mutate := range []func(*OperationRequest){func(r *OperationRequest) { r.AgentID = "other"; r.Issue.AgentID = "other" }, func(r *OperationRequest) { r.Issue.Reason = "different" }, func(r *OperationRequest) { r.Issue.RequestedScopes[0].ContextConstraints["site"] = "B" }, func(r *OperationRequest) { r.ExpectedAgentRevision = 1 }} {
+		changed := issueOperation("same", "", 0)
+		mutate(&changed)
+		if _, err := s.ApplyOperation(context.Background(), changed); err == nil {
+			t.Fatal("conflicting operation accepted")
+		}
+	}
+	if _, err := s.GetOperation("other", "same"); !errors.Is(err, ErrNotFound) {
+		t.Fatal("cross agent lookup exposed receipt", err)
+	}
+}
+func TestOperationRevokeReceiptNotInferredFromEmptyCurrent(t *testing.T) {
+	store := newTestStateStore()
+	s := testPersistent(t, store, "")
+	first := applyOperation(t, s, issueOperation("issue", "", 0)).Payload()
+	request := OperationRequest{OperationID: "revoke", AgentID: "agent", Action: "REVOKE", ExpectedActivePassportID: first.ActivePassportID, ExpectedAgentRevision: 1, Revoke: &OperationRevoke{PassportID: first.ActivePassportID, Reason: "drift", RevokedBy: "authority"}}
+	receipt := applyOperation(t, s, request)
+	s = testPersistent(t, store, "")
+	if receipt.Payload().AgentRevision != 2 || receipt.Payload().ActivePassportID != "" || receipt.Payload().Result.Status != "REVOKED" {
+		t.Fatal("wrong revoke receipt")
+	}
+	if _, err := s.GetOperation("agent", "never-applied"); !errors.Is(err, ErrNotFound) {
+		t.Fatal("empty state fabricated receipt", err)
+	}
+	applyOperation(t, s, issueOperation("later", "", 2))
+	retry := applyOperation(t, s, request)
+	if !bytes.Equal(receipt.CanonicalPayload, retry.CanonicalPayload) {
+		t.Fatal("historical revoke lost")
+	}
+}
+func TestConcurrentSameOperationHasOneTransition(t *testing.T) {
+	s := testPersistent(t, newTestStateStore(), "")
+	request := issueOperation("same", "", 0)
+	var wg sync.WaitGroup
+	receipts := make(chan OperationReceipt, 12)
+	errs := make(chan error, 12)
+	for i := 0; i < 12; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			r, e := s.ApplyOperation(context.Background(), request)
+			receipts <- r
+			errs <- e
+		}()
+	}
+	wg.Wait()
+	close(receipts)
+	close(errs)
+	for err := range errs {
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	var payload []byte
+	for r := range receipts {
+		if payload == nil {
+			payload = r.CanonicalPayload
+		}
+		if !bytes.Equal(payload, r.CanonicalPayload) {
+			t.Fatal("different results")
+		}
+	}
+	_, rev, _ := s.GetAgentPassportRevision("agent")
+	if rev != 1 {
+		t.Fatal("duplicate transition", rev)
+	}
+}
+func TestOperationPersistenceFailureRollsBackReceiptAndAuthority(t *testing.T) {
+	store := newTestStateStore()
+	s := testPersistent(t, store, "")
+	first := applyOperation(t, s, issueOperation("first", "", 0)).Payload()
+	store.err = errors.New("disk full")
+	if _, err := s.ApplyOperation(context.Background(), issueOperation("failed", first.ActivePassportID, 1)); !errors.Is(err, ErrUnavailable) {
+		t.Fatal(err)
+	}
+	if _, err := s.GetOperation("agent", "failed"); !errors.Is(err, ErrNotFound) {
+		t.Fatal("failed mutation recorded", err)
+	}
+	current, rev, err := s.GetAgentPassportRevision("agent")
+	if err != nil || rev != 1 || current.PassportID != first.ActivePassportID || current.Status != domain.StatusActive {
+		t.Fatal("failed replacement changed current", err)
+	}
+}
+func TestOperationMigratesV1WithoutChangingPriorAuthority(t *testing.T) {
+	store := newTestStateStore()
+	s := testPersistent(t, store, "")
+	prior, err := s.IssuePassport(persistentIssue("none", 0))
+	if err != nil {
+		t.Fatal(err)
+	}
+	store.state.Version = 1
+	store.state.Operations = nil
+	s = testPersistent(t, store, "")
+	current, _, _ := s.GetAgentPassportRevision("agent")
+	if !bytes.Equal(CanonicalPayload(prior), CanonicalPayload(current)) {
+		t.Fatal("migration changed old payload")
+	}
+	applyOperation(t, s, issueOperation("migrated", prior.PassportID, 1))
+	if store.state.Version != 2 || len(store.state.Operations) != 1 {
+		t.Fatal("snapshot not upgraded atomically")
+	}
+}
+
+type receiptFailCredentials struct{ credentialMock }
