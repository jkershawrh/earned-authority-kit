+++ b/internal/service/persistence.go
@@ -0,0 +1,109 @@
+package service
+
+import (
+	"errors"
+	"fmt"
+	"github.com/srex-dev/agent-passport/internal/domain"
+)
+
+// State is one atomically replaced single-writer snapshot. It is not a
+// distributed database and does not provide anti-rollback against its owner.
+type State struct {
+	Operations    map[string]OperationReceipt `json:"operations"`
+	Version       int                         `json:"version"`
+	Passports     map[string]domain.Passport  `json:"passports"`
+	ActiveByAgent map[string]string           `json:"active_by_agent"`
+	Revisions     map[string]uint64           `json:"revisions"`
+}
+type StateStore interface {
+	Load() (State, error)
+	Save(State) error
+}
+
+// ErrCommitUnknown means rename succeeded but durability could not be confirmed.
+// The service stops serving until restarted from the durable snapshot.
+var ErrCommitUnknown = errors.New("commit outcome unknown")
+
+func NewPersistent(registry AgentRegistryClient, credentials CredentialStoreClient, ledger LedgerClient, outbox OutboxWriter, bundles PolicyBundleRegistryClient, store StateStore, fencePath string) (*Service, error) {
+	if registry == nil || credentials == nil || store == nil {
+		return nil, ErrInvalidArgument
+	}
+	s := New(registry, credentials, ledger, outbox, bundles)
+	s.store = store
+	s.requireCAS = true
+	s.fencePath = fencePath
+	state, err := store.Load()
+	if err != nil {
+		return nil, err
+	}
+	if (state.Version != 1 && state.Version != 2) || state.Passports == nil || state.ActiveByAgent == nil || state.Revisions == nil {
+		return nil, fmt.Errorf("invalid persisted state")
+	}
+	if state.Version == 1 {
+		if len(state.Operations) != 0 {
+			return nil, fmt.Errorf("v1 state contains unsupported operations")
+		}
+		state.Operations = map[string]OperationReceipt{}
+	} else if state.Operations == nil {
+		return nil, fmt.Errorf("v2 operation index missing")
+	}
+	for id, p := range state.Passports {
+		if id != p.PassportID || p.AgentID == "" || p.Revision == 0 || state.Revisions[p.AgentID] < p.Revision {
+			return nil, fmt.Errorf("invalid persisted identity/revision")
+		}
+		valid, err := credentials.Verify(p.PublicKeyPEM, CanonicalPayload(p), p.Signature)
+		if err != nil || !valid {
+			return nil, fmt.Errorf("persisted signature invalid for passport %s", id)
+		}
+		if p.Status == domain.StatusActive && state.ActiveByAgent[p.AgentID] != id {
+			return nil, fmt.Errorf("unindexed active passport")
+		}
+	}
+	for agent, id := range state.ActiveByAgent {
+		p, ok := state.Passports[id]
+		if !ok || p.AgentID != agent || p.Status != domain.StatusActive || p.Revision != state.Revisions[agent] {
+			return nil, fmt.Errorf("invalid active passport index")
+		}
+	}
+	for id, receipt := range state.Operations {
+		if err := s.validateStoredOperation(id, receipt, state); err != nil {
+			return nil, err
+		}
+	}
+	s.operations = state.Operations
+	s.passports = state.Passports
+	s.activeByAgent = state.ActiveByAgent
+	s.revisions = state.Revisions
+	return s, nil
+}
+func (s *Service) snapshot() State {
+	state := State{Version: 2, Operations: make(map[string]OperationReceipt, len(s.operations)), Passports: make(map[string]domain.Passport, len(s.passports)), ActiveByAgent: make(map[string]string, len(s.activeByAgent)), Revisions: make(map[string]uint64, len(s.revisions))}
+	for k, v := range s.operations {
+		state.Operations[k] = cloneReceipt(v)
+	}
+	for k, v := range s.passports {
+		state.Passports[k] = clonePassport(v)
+	}
+	for k, v := range s.activeByAgent {
+		state.ActiveByAgent[k] = v
+	}
+	for k, v := range s.revisions {
+		state.Revisions[k] = v
+	}
+	return state
+}
+func (s *Service) commit(next State) error {
+	if s.store != nil {
+		if err := s.store.Save(next); err != nil {
+			if errors.Is(err, ErrCommitUnknown) {
+				s.poisoned = true
+			}
+			return fmt.Errorf("%w: persistence: %v", ErrUnavailable, err)
+		}
+	}
+	s.operations = next.Operations
+	s.passports = next.Passports
+	s.activeByAgent = next.ActiveByAgent
+	s.revisions = next.Revisions
+	return nil
+}
