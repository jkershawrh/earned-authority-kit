--- /dev/null
+++ b/internal/local/durable.go
@@ -0,0 +1,195 @@
+package local
+
+import (
+	"bytes"
+	"crypto/ed25519"
+	"crypto/rand"
+	"crypto/sha256"
+	"crypto/x509"
+	"encoding/hex"
+	"encoding/json"
+	"encoding/pem"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/srex-dev/agent-passport/internal/service"
+)
+
+type Ed25519Credentials struct {
+	private ed25519.PrivateKey
+	public  ed25519.PublicKey
+	pem     string
+	id      string
+}
+
+func OpenEd25519Credentials(path string) (*Ed25519Credentials, error) {
+	if err := os.MkdirAll(filepath.Dir(path), 0700); err != nil {
+		return nil, err
+	}
+	data, err := os.ReadFile(path)
+	if os.IsNotExist(err) {
+		_, key, err := ed25519.GenerateKey(rand.Reader)
+		if err != nil {
+			return nil, err
+		}
+		der, err := x509.MarshalPKCS8PrivateKey(key)
+		if err != nil {
+			return nil, err
+		}
+		data = pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: der})
+		f, err := os.OpenFile(path, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+		if err != nil {
+			return nil, err
+		}
+		if _, err = f.Write(data); err == nil {
+			err = f.Sync()
+		}
+		closeErr := f.Close()
+		if err != nil {
+			return nil, err
+		}
+		if closeErr != nil {
+			return nil, closeErr
+		}
+		dir, err := os.Open(filepath.Dir(path))
+		if err != nil {
+			return nil, err
+		}
+		err = dir.Sync()
+		dir.Close()
+		if err != nil {
+			return nil, err
+		}
+	} else if err != nil {
+		return nil, err
+	}
+	info, err := os.Lstat(path)
+	if err != nil {
+		return nil, err
+	}
+	if !info.Mode().IsRegular() || info.Mode().Perm()&0077 != 0 {
+		return nil, fmt.Errorf("signing key must be a private regular file (0600)")
+	}
+	block, rest := pem.Decode(data)
+	if block == nil || block.Type != "PRIVATE KEY" || len(bytes.TrimSpace(rest)) != 0 {
+		return nil, fmt.Errorf("invalid signing key PEM")
+	}
+	raw, err := x509.ParsePKCS8PrivateKey(block.Bytes)
+	if err != nil {
+		return nil, err
+	}
+	key, ok := raw.(ed25519.PrivateKey)
+	if !ok {
+		return nil, fmt.Errorf("signing key must be Ed25519")
+	}
+	pub := key.Public().(ed25519.PublicKey)
+	der, err := x509.MarshalPKIXPublicKey(pub)
+	if err != nil {
+		return nil, err
+	}
+	sum := sha256.Sum256(der)
+	return &Ed25519Credentials{private: key, public: pub, pem: string(pem.EncodeToMemory(&pem.Block{Type: "PUBLIC KEY", Bytes: der})), id: "ed25519:" + hex.EncodeToString(sum[:])}, nil
+}
+func (c *Ed25519Credentials) Identity() (string, string, error) { return c.id, c.pem, nil }
+func (c *Ed25519Credentials) Sign(payload []byte) (string, string, []byte, error) {
+	return c.id, c.pem, ed25519.Sign(c.private, payload), nil
+}
+func (c *Ed25519Credentials) Verify(publicKey string, payload, signature []byte) (bool, error) {
+	block, rest := pem.Decode([]byte(publicKey))
+	if block == nil || block.Type != "PUBLIC KEY" || len(bytes.TrimSpace(rest)) != 0 {
+		return false, nil
+	}
+	raw, err := x509.ParsePKIXPublicKey(block.Bytes)
+	if err != nil {
+		return false, nil
+	}
+	key, ok := raw.(ed25519.PublicKey)
+	if !ok || !bytes.Equal(key, c.public) {
+		return false, nil
+	}
+	return ed25519.Verify(key, payload, signature), nil
+}
+
+// RegistryHTTP is a real status read; no ACTIVE fallback is used on failures.
+type RegistryHTTP struct {
+	BaseURL string
+	Token   string
+	Client  *http.Client
+}
+
+func (r RegistryHTTP) GetAgentStatus(agentID string) (service.AgentStatus, error) {
+	endpoint := strings.TrimRight(r.BaseURL, "/") + "/v1/identity/agents/" + url.PathEscape(agentID)
+	req, err := http.NewRequest(http.MethodGet, endpoint, nil)
+	if err != nil {
+		return "", err
+	}
+	req.Header.Set("X-Request-ID", uuid.NewString())
+	req.Header.Set("X-ARE-Agent-ID", "passport-authority")
+	if r.Token != "" {
+		req.Header.Set("Authorization", "Bearer "+r.Token)
+	}
+	client := r.Client
+	if client == nil {
+		client = &http.Client{Timeout: 2 * time.Second}
+	}
+	response, err := client.Do(req)
+	if err != nil {
+		return "", err
+	}
+	defer response.Body.Close()
+	if response.StatusCode != http.StatusOK {
+		return "", fmt.Errorf("registry returned %d", response.StatusCode)
+	}
+	var body struct {
+		Agent struct {
+			ID     string              `json:"agent_id"`
+			Status service.AgentStatus `json:"status"`
+		} `json:"agent"`
+	}
+	if err := json.NewDecoder(io.LimitReader(response.Body, 1<<20)).Decode(&body); err != nil {
+		return "", err
+	}
+	if body.Agent.ID != agentID {
+		return "", fmt.Errorf("registry identity mismatch")
+	}
+	switch body.Agent.Status {
+	case service.AgentActive, service.AgentPending, service.AgentSuspended, service.AgentDeregistered:
+		return body.Agent.Status, nil
+	default:
+		return "", fmt.Errorf("unknown registry status")
+	}
+}
+
+type DurableConfig struct{ StatePath, KeyPath, FencePath, RegistryURL, RegistryToken, PolicyID, PolicyVersion string }
+
+func NewDurableService(c DurableConfig) (*service.Service, func() error, error) {
+	if c.StatePath == "" || c.KeyPath == "" || c.RegistryURL == "" || c.PolicyID == "" || c.PolicyVersion == "" {
+		return nil, nil, fmt.Errorf("durable mode requires state/key paths, registry URL and policy identity/version")
+	}
+	parsed, err := url.Parse(c.RegistryURL)
+	if err != nil || parsed.Host == "" || (parsed.Scheme != "http" && parsed.Scheme != "https") {
+		return nil, nil, fmt.Errorf("invalid registry URL")
+	}
+	store, err := service.OpenFileStore(c.StatePath)
+	if err != nil {
+		return nil, nil, err
+	}
+	credentials, err := OpenEd25519Credentials(c.KeyPath)
+	if err != nil {
+		store.Close()
+		return nil, nil, err
+	}
+	svc, err := service.NewPersistent(RegistryHTTP{BaseURL: c.RegistryURL, Token: c.RegistryToken}, credentials, nil, nil, BundleStub{ID: c.PolicyID, Ver: c.PolicyVersion}, store, c.FencePath)
+	if err != nil {
+		store.Close()
+		return nil, nil, err
+	}
+	return svc, store.Close, nil
+}
