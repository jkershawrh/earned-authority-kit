+	"time"
+
+	"github.com/srex-dev/agent-passport/internal/domain"
+)
+
+func issueForHardening(t *testing.T, s *Service) domain.Passport {
+	t.Helper()
+	p, err := s.IssuePassport(IssueInput{AgentID: "agent", PassportType: domain.TypeStandard, Scopes: []domain.Scope{scope("WRITE")}, TTLSeconds: 3600, IssuedBy: "authority", Reason: "qualification"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
+
+func TestFailedForceReissueLeavesOriginalActive(t *testing.T) {
+	for _, failure := range []string{"signer", "policy"} {
+		t.Run(failure, func(t *testing.T) {
+			s := New(registryMock{status: AgentActive}, credentialMock{}, ledgerMock{}, outboxMock{})
+			p := issueForHardening(t, s)
+			if failure == "signer" {
+				s.credentials = credentialMock{failSign: true}
+			} else {
+				s.policyBundles = bundleMock{err: errors.New("unavailable")}
+			}
+			_, err := s.IssuePassport(IssueInput{AgentID: "agent", PassportType: domain.TypeStandard, Scopes: []domain.Scope{scope("WRITE")}, TTLSeconds: 3600, IssuedBy: "authority", Reason: "replacement", ForceReissue: true})
+			if !errors.Is(err, ErrUnavailable) {
+				t.Fatalf("error: %v", err)
+			}
+			got, err := s.GetAgentPassport("agent")
+			if err != nil || got.PassportID != p.PassportID || got.Status != domain.StatusActive {
+				t.Fatalf("failed replacement changed authority: %+v %v", got, err)
+			}
+		})
+	}
+}
+
+func TestVerifyRejectsUnrelatedSignedPayload(t *testing.T) {
+	s := New(registryMock{status: AgentActive}, credentialMock{}, nil, outboxMock{})
+	p := issueForHardening(t, s)
+	payload := []byte("unrelated signed message")
+	_, _, sig, _ := s.credentials.Sign(payload)
+	valid, _, _, err := s.VerifyPassport(p.PassportID, payload, sig)
+	if err != nil || valid {
+		t.Fatalf("unrelated payload authorized: valid=%v err=%v", valid, err)
+	}
+}
+
+func TestCanonicalSignatureBindsAuthority(t *testing.T) {
+	cases := []struct {
+		name   string
+		mutate func(*domain.Passport)
+	}{
+		{"credential_id", func(p *domain.Passport) { p.CredentialID = "changed-key" }},
+		{"public_key", func(p *domain.Passport) { p.PublicKeyPEM = "untrusted-key" }},
+		{"revision", func(p *domain.Passport) { p.Revision++ }},
+		{"passport_id", func(p *domain.Passport) { p.PassportID = "changed" }},
+		{"agent_id", func(p *domain.Passport) { p.AgentID = "different-agent" }},
+		{"context", func(p *domain.Passport) { p.ScopeSet[0].ContextConstraints = map[string]string{"site": "B"} }},
+		{"scope_expiry", func(p *domain.Passport) { p.ScopeSet[0].ExpiresTS = p.ScopeSet[0].ExpiresTS.Add(time.Hour) }},
+		{"scope_grant", func(p *domain.Passport) { p.ScopeSet[0].GrantedTS = p.ScopeSet[0].GrantedTS.Add(-time.Hour) }},
+		{"escalation", func(p *domain.Passport) { p.ScopeSet[0].IsEscalation = true }},
+		{"policy_id", func(p *domain.Passport) { p.PolicyIDAtIssuance = "different-policy" }},
+		{"policy_version", func(p *domain.Passport) { p.PolicyVerAtIssuance = "999" }},
+		{"issuer", func(p *domain.Passport) { p.IssuedBy = "different-authority" }},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			s := New(registryMock{status: AgentActive}, credentialMock{}, nil, outboxMock{})
+			p := issueForHardening(t, s)
+			payload := bytes.TrimPrefix(p.Signature, []byte("sig:"))
+			altered := s.passports[p.PassportID]
+			tc.mutate(&altered)
+			s.passports[p.PassportID] = altered
+			valid, _, _, err := s.VerifyPassport(p.PassportID, payload, p.Signature)
+			if err != nil || valid {
+				t.Fatalf("tampered authority authorized: %v %v", valid, err)
+			}
+		})
+	}
+}
+
+func TestReturnedRecordsDoNotMutateAuthority(t *testing.T) {
+	s := New(registryMock{status: AgentActive}, credentialMock{}, nil, outboxMock{})
+	p := issueForHardening(t, s)
+	p.ScopeSet[0].ResourcePattern = "unbounded/*"
+	got, _ := s.GetPassport(p.PassportID)
+	if got.ScopeSet[0].ResourcePattern == "unbounded/*" {
+		t.Fatal("issuer return aliases stored authority")
+	}
+	got.ScopeSet[0].ContextConstraints = map[string]string{"site": "A"}
+	got.ScopeSet[0].ResourcePattern = "mutated/*"
+	again, _ := s.GetPassport(p.PassportID)
+	if again.ScopeSet[0].ResourcePattern == "mutated/*" {
+		t.Fatal("getter return aliases stored authority")
+	}
+}
+
+func TestVerificationChecksCurrentIdentityAndActivePointer(t *testing.T) {
+	for _, change := range []string{"suspended", "deregistered", "not_active_pointer"} {
+		t.Run(change, func(t *testing.T) {
+			s := New(registryMock{status: AgentActive}, credentialMock{}, nil, outboxMock{})
+			p := issueForHardening(t, s)
+			payload := bytes.TrimPrefix(p.Signature, []byte("sig:"))
+			if change == "suspended" {
+				s.registry = registryMock{status: AgentSuspended}
+			} else if change == "deregistered" {
+				s.registry = registryMock{status: AgentDeregistered}
+			} else {
+				delete(s.activeByAgent, p.AgentID)
+			}
+			valid, _, _, err := s.VerifyPassport(p.PassportID, payload, p.Signature)
+			if err != nil || valid {
+				t.Fatalf("inactive identity/authority authorized: %v %v", valid, err)
+			}
+		})
+	}
+}
+
+func TestExpiryBoundaryAndSignatureIsolation(t *testing.T) {
+	s := New(registryMock{status: AgentActive}, credentialMock{}, nil, nil)
+	now := time.Now().UTC()
+	s.now = func() time.Time { return now }
+	input := IssueInput{AgentID: "agent", PassportType: domain.TypeStandard, Scopes: []domain.Scope{{ScopeID: "scope", ActionClass: "WRITE", ResourcePattern: "model/*", GrantedTS: now, ExpiresTS: now.Add(time.Hour), ContextConstraints: map[string]string{"site": "A"}}}, TTLSeconds: 3600, IssuedBy: "authority", Reason: "qualified"}
+	p, err := s.IssuePassport(input)
+	if err != nil {
+		t.Fatal(err)
+	}
+	input.Scopes[0].ContextConstraints["site"] = "outside"
+	p.ScopeSet[0].ContextConstraints["site"] = "outside"
+	p.Signature[0] ^= 0xff
+	stored, _ := s.GetPassport(p.PassportID)
+	if stored.ScopeSet[0].ContextConstraints["site"] != "A" {
+		t.Fatal("context map aliases authority")
+	}
+	valid, _, _, err := s.VerifyPassport(p.PassportID, nil, nil)
+	if err != nil || !valid {
+		t.Fatal("external signature mutation corrupted record", err)
+	}
+	now = stored.ExpiresTS
+	valid, status, reason, err := s.VerifyPassport(p.PassportID, nil, nil)
+	if err != nil || valid || status != domain.StatusExpired || reason != "expired" {
+		t.Fatal("expiry boundary accepted", valid, status, reason, err)
+	}
+}
