+++ b/internal/grpc/operations_transport_test.go
@@ -0,0 +1,75 @@
+package grpc
+
+import (
+	"bytes"
+	"context"
+	"crypto/ed25519"
+	"crypto/x509"
+	"encoding/json"
+	"encoding/pem"
+	"github.com/srex-dev/agent-passport/internal/service"
+	pb "github.com/srex-dev/agent-passport/proto"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/metadata"
+	"google.golang.org/grpc/status"
+	"testing"
+)
+
+func operationContext() context.Context {
+	return metadata.NewOutgoingContext(context.Background(), metadata.Pairs("authorization", "Bearer test-secret"))
+}
+func TestOperationTransportSignedLookupAndAuthentication(t *testing.T) {
+	client := transportClient(t)
+	request := &pb.ApplyPassportOperationRequest{OperationId: "operation1", AgentId: "agent", Mutation: &pb.ApplyPassportOperationRequest_Issue{Issue: issueRequest()}}
+	if _, err := client.ApplyPassportOperation(context.Background(), request); status.Code(err) != codes.Unauthenticated {
+		t.Fatal("unprotected mutation", err)
+	}
+	result, err := client.ApplyPassportOperation(operationContext(), request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	receipt := result.Receipt
+	block, _ := pem.Decode([]byte(receipt.PublicKeyPem))
+	key, err := x509.ParsePKIXPublicKey(block.Bytes)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !ed25519.Verify(key.(ed25519.PublicKey), receipt.CanonicalPayload, receipt.Signature) {
+		t.Fatal("invalid receipt signature")
+	}
+	var payload service.OperationPayload
+	if err = json.Unmarshal(receipt.CanonicalPayload, &payload); err != nil {
+		t.Fatal(err)
+	}
+	if payload.AgentRevision != 1 || payload.Request.Issue.RequestedScopes[0].ScopeTTLSeconds != 60 {
+		t.Fatal("request/result missing binding")
+	}
+	lookup := &pb.GetPassportOperationRequest{AgentId: "agent", OperationId: "operation1"}
+	if _, err = client.GetPassportOperation(context.Background(), lookup); status.Code(err) != codes.Unauthenticated {
+		t.Fatal("unauthenticated operation lookup", err)
+	}
+	found, err := client.GetPassportOperation(operationContext(), lookup)
+	if err != nil || !bytes.Equal(found.Receipt.CanonicalPayload, receipt.CanonicalPayload) {
+		t.Fatal("lookup failed", err)
+	}
+	retry, err := client.ApplyPassportOperation(operationContext(), request)
+	if err != nil || !bytes.Equal(retry.Receipt.CanonicalPayload, receipt.CanonicalPayload) {
+		t.Fatal("retry failed", err)
+	}
