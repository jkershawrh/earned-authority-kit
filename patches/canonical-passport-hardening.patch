@@ -0,0 +1,76 @@
+package grpc
+
+import (
+	"context"
+	"crypto/subtle"
+	"fmt"
+	"github.com/srex-dev/agent-passport/internal/domain"
+	"github.com/srex-dev/agent-passport/internal/service"
+	"strconv"
+	"strings"
+
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/metadata"
+	"google.golang.org/grpc/status"
+)
+
+const ExpectedActiveHeader = "x-are-expected-active-passport-id"
+const ExpectedRevisionHeader = "x-are-expected-agent-revision"
+const AgentRevisionHeader = "x-are-agent-revision"
+
+func expectedActive(ctx context.Context) (*string, error) {
+	values := metadata.ValueFromIncomingContext(ctx, ExpectedActiveHeader)
+	if len(values) == 0 {
+		return nil, nil
+	}
+	if len(values) != 1 || strings.TrimSpace(values[0]) == "" {
+		return nil, status.Error(codes.InvalidArgument, "one nonempty expected active passport is required")
+	}
+	return &values[0], nil
+}
+func expectedRevision(ctx context.Context) (*uint64, error) {
+	values := metadata.ValueFromIncomingContext(ctx, ExpectedRevisionHeader)
+	if len(values) == 0 {
+		return nil, nil
+	}
+	if len(values) != 1 {
+		return nil, status.Error(codes.InvalidArgument, "one expected agent revision is required")
+	}
+	revision, err := strconv.ParseUint(values[0], 10, 64)
+	if err != nil {
+		return nil, status.Error(codes.InvalidArgument, "invalid expected agent revision")
+	}
+	return &revision, nil
+}
+func revisionHeader(ctx context.Context, revision uint64) {
+	_ = grpc.SetHeader(ctx, metadata.Pairs(AgentRevisionHeader, fmt.Sprint(revision)))
+	_ = grpc.SetTrailer(ctx, metadata.Pairs(AgentRevisionHeader, fmt.Sprint(revision)))
+}
+
+// MutationTokenInterceptor protects administrative mutation calls in durable
+// reference mode. Transport security and caller-specific policy remain external.
+func MutationTokenInterceptor(token string) grpc.UnaryServerInterceptor {
+	return func(ctx context.Context, req any, info *grpc.UnaryServerInfo, handler grpc.UnaryHandler) (any, error) {
+		method := info.FullMethod
+		mutation := strings.HasSuffix(method, "/IssuePassport") || strings.HasSuffix(method, "/RevokePassport") || strings.HasSuffix(method, "/RenewPassport")
+		if token != "" && mutation {
+			values := metadata.ValueFromIncomingContext(ctx, "authorization")
+			if len(values) != 1 || subtle.ConstantTimeCompare([]byte(values[0]), []byte("Bearer "+token)) != 1 {
+				return nil, status.Error(codes.Unauthenticated, "mutation credential required")
+			}
+		}
+		return handler(ctx, req)
+	}
+}
+
+const CanonicalPayloadHeader = "x-are-canonical-payload-bin"
+
+func canonicalHeader(ctx context.Context, p domain.Passport) {
+	if p.PassportID == "" {
+		return
+	}
+	data := string(service.CanonicalPayload(p))
+	_ = grpc.SetHeader(ctx, metadata.Pairs(CanonicalPayloadHeader, data))
+	_ = grpc.SetTrailer(ctx, metadata.Pairs(CanonicalPayloadHeader, data))
+}
