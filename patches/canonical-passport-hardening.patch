@@ -0,0 +1,69 @@
+package service
+
+import (
+	"encoding/json"
+	"github.com/srex-dev/agent-passport/internal/domain"
+)
+
+// CanonicalPayload v2 uses named, unambiguous fields and deterministic JSON map
+// key ordering. Lifecycle status is authoritative mutable state; issuance
+// identity, revision, scope conditions, expiry, issuer, and policy are signed.
+func CanonicalPayload(p domain.Passport) []byte {
+	type canonicalScope struct {
+		ID         string            `json:"scope_id"`
+		Action     string            `json:"action_class"`
+		Resource   string            `json:"resource_pattern"`
+		Context    map[string]string `json:"context_constraints"`
+		Granted    int64             `json:"granted_ts"`
+		Expires    int64             `json:"expires_ts"`
+		Escalation bool              `json:"is_escalation"`
+	}
+	scopes := make([]canonicalScope, len(p.ScopeSet))
+	for i, s := range p.ScopeSet {
+		cc := s.ContextConstraints
+		if cc == nil {
+			cc = map[string]string{}
+		}
+		scopes[i] = canonicalScope{s.ScopeID, s.ActionClass, s.ResourcePattern, cc, s.GrantedTS.UnixMilli(), s.ExpiresTS.UnixMilli(), s.IsEscalation}
+	}
+	payload := struct {
+		CredentialID  string              `json:"credential_id"`
+		PublicKey     string              `json:"public_key_pem"`
+		Version       string              `json:"canonical_version"`
+		PassportID    string              `json:"passport_id"`
+		AgentID       string              `json:"agent_id"`
+		Revision      uint64              `json:"issuance_revision"`
+		Type          domain.PassportType `json:"passport_type"`
+		Scopes        []canonicalScope    `json:"scope_set"`
+		Issuer        string              `json:"issued_by"`
+		Reason        string              `json:"reason"`
+		Issued        int64               `json:"issued_ts"`
+		Expires       int64               `json:"expires_ts"`
+		PolicyID      string              `json:"policy_id_at_issuance"`
+		PolicyVersion string              `json:"policy_ver_at_issuance"`
+	}{p.CredentialID, p.PublicKeyPEM, "are.passport.v2", p.PassportID, p.AgentID, p.Revision, p.PassportType, scopes, p.IssuedBy, p.Reason, p.IssuedTS.UnixMilli(), p.ExpiresTS.UnixMilli(), p.PolicyIDAtIssuance, p.PolicyVerAtIssuance}
+	data, _ := json.Marshal(payload) // This closed schema has no unsupported values.
+	return data
+}
+
+func cloneScopes(scopes []domain.Scope) []domain.Scope {
+	out := append([]domain.Scope(nil), scopes...)
+	for i := range out {
+		if scopes[i].ContextConstraints != nil {
+			out[i].ContextConstraints = make(map[string]string, len(scopes[i].ContextConstraints))
+			for k, v := range scopes[i].ContextConstraints {
+				out[i].ContextConstraints[k] = v
+			}
+		}
+	}
+	return out
+}
+func clonePassport(p domain.Passport) domain.Passport {
+	p.ScopeSet = cloneScopes(p.ScopeSet)
+	p.Signature = append([]byte(nil), p.Signature...)
+	if p.RevokedTS != nil {
+		v := *p.RevokedTS
+		p.RevokedTS = &v
+	}
+	return p
+}
