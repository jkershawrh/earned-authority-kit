new file mode 100644
--- /dev/null
+++ b/internal/service/file_store.go
@@ -0,0 +1,104 @@
+package service
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"github.com/srex-dev/agent-passport/internal/domain"
+	"io"
+	"os"
+	"path/filepath"
+)
+
+type FileStore struct {
+	path string
+	lock *os.File
+}
+
+func OpenFileStore(path string) (*FileStore, error) {
+	if path == "" {
+		return nil, ErrInvalidArgument
+	}
+	if err := os.MkdirAll(filepath.Dir(path), 0700); err != nil {
+		return nil, err
+	}
+	lock, err := os.OpenFile(path+".lock", os.O_CREATE|os.O_RDWR, 0600)
+	if err != nil {
+		return nil, err
+	}
+	if err = lockStore(lock); err != nil {
+		lock.Close()
+		return nil, fmt.Errorf("state already owned: %w", err)
+	}
+	return &FileStore{path: path, lock: lock}, nil
+}
+func (s *FileStore) Close() error {
+	if s.lock == nil {
+		return nil
+	}
+	_ = unlockStore(s.lock)
+	err := s.lock.Close()
+	s.lock = nil
+	return err
+}
+func (s *FileStore) Load() (State, error) {
+	b, err := os.ReadFile(s.path)
+	if errors.Is(err, os.ErrNotExist) {
+		return State{Version: 1, Passports: map[string]domain.Passport{}, ActiveByAgent: map[string]string{}, Revisions: map[string]uint64{}}, nil
+	}
+	if err != nil {
+		return State{}, err
+	}
+	var state State
+	d := json.NewDecoder(bytes.NewReader(b))
+	d.DisallowUnknownFields()
+	if err = d.Decode(&state); err != nil {
+		return State{}, err
+	}
+	var extra any
+	if err = d.Decode(&extra); err != io.EOF {
+		return State{}, fmt.Errorf("invalid state trailer")
+	}
+	return state, nil
+}
+func (s *FileStore) Save(state State) error {
+	if s.lock == nil {
+		return fmt.Errorf("state store is closed")
+	}
+	b, err := json.Marshal(state)
+	if err != nil {
+		return err
+	}
+	f, err := os.CreateTemp(filepath.Dir(s.path), ".passport-state-*")
+	if err != nil {
+		return err
+	}
+	name := f.Name()
+	defer os.Remove(name)
+	defer f.Close()
+	if err = f.Chmod(0600); err != nil {
+		return err
+	}
+	if _, err = f.Write(b); err != nil {
+		return err
+	}
+	if err = f.Sync(); err != nil {
+		return err
+	}
+	if err = f.Close(); err != nil {
+		return err
+	}
+	if err = os.Rename(name, s.path); err != nil {
+		return err
+	}
+	dir, err := os.Open(filepath.Dir(s.path))
+	if err != nil {
+		return fmt.Errorf("%w: %v", ErrCommitUnknown, err)
+	}
+	defer dir.Close()
+	if err = dir.Sync(); err != nil {
+		return fmt.Errorf("%w: %v", ErrCommitUnknown, err)
+	}
+	return nil
+}
