+func (c receiptFailCredentials) Sign(payload []byte) (string, string, []byte, error) {
+	if bytes.Contains(payload, []byte(`"canonical_version":"are.passport.operation.v1"`)) {
+		return "", "", nil, errors.New("receipt signer unavailable")
+	}
+	return c.credentialMock.Sign(payload)
+}
+func TestOperationReceiptSignerFailureIsAtomic(t *testing.T) {
+	for _, action := range []string{"ISSUE", "REVOKE"} {
+		t.Run(action, func(t *testing.T) {
+			store := newTestStateStore()
+			s := testPersistent(t, store, "")
+			first := applyOperation(t, s, issueOperation("first", "", 0)).Payload()
+			s.credentials = receiptFailCredentials{}
+			request := issueOperation("failed", first.ActivePassportID, 1)
+			if action == "REVOKE" {
+				request.Action = "REVOKE"
+				request.Issue = nil
+				request.Revoke = &OperationRevoke{PassportID: first.ActivePassportID, Reason: "drift", RevokedBy: "authority"}
+			}
+			if _, err := s.ApplyOperation(context.Background(), request); !errors.Is(err, ErrUnavailable) {
+				t.Fatal(err)
+			}
+			current, rev, err := s.GetAgentPassportRevision("agent")
+			if err != nil || current.PassportID != first.ActivePassportID || current.Status != domain.StatusActive || rev != 1 {
+				t.Fatal("receipt failure changed authority", err)
+			}
+			if _, err := s.GetOperation("agent", "failed"); !errors.Is(err, ErrNotFound) {
+				t.Fatal("receipt failure recorded operation", err)
+			}
+		})
+	}
+}
+
+type operationUnknownStore struct {
+	testStateStore
+	fail bool
+}
+
+func (s *operationUnknownStore) Save(state State) error {
+	s.state = state
+	if s.fail {
+		return ErrCommitUnknown
+	}
+	return nil
+}
+func TestOperationUncertainCommitRecoversReceiptOnRestart(t *testing.T) {
+	store := &operationUnknownStore{testStateStore: *newTestStateStore(), fail: true}
+	s := testPersistent(t, store, "")
+	request := issueOperation("uncertain", "", 0)
+	if _, err := s.ApplyOperation(context.Background(), request); !errors.Is(err, ErrUnavailable) {
+		t.Fatal(err)
+	}
+	if _, err := s.GetOperation("agent", "uncertain"); !errors.Is(err, ErrUnavailable) {
+		t.Fatal("unknown commit served")
+	}
+	store.fail = false
+	s = testPersistent(t, store, "")
+	found, err := s.GetOperation("agent", "uncertain")
+	if err != nil {
+		t.Fatal(err)
+	}
+	replay := applyOperation(t, s, request)
+	if !bytes.Equal(found.CanonicalPayload, replay.CanonicalPayload) {
+		t.Fatal("lost-response recovery changed result")
+	}
+	_, rev, _ := s.GetAgentPassportRevision("agent")
+	if rev != 1 {
+		t.Fatal("recovery repeated mutation")
+	}
+}
+func TestOperationCorruptionRejectedAndReturnedBytesDoNotAlias(t *testing.T) {
+	store := newTestStateStore()
+	s := testPersistent(t, store, "")
+	receipt := applyOperation(t, s, issueOperation("first", "", 0))
+	original := append([]byte(nil), receipt.CanonicalPayload...)
+	receipt.CanonicalPayload[0] = '!'
+	receipt.Signature[0] = '!'
+	actual, err := s.GetOperation("agent", "first")
+	if err != nil || !bytes.Equal(original, actual.CanonicalPayload) {
+		t.Fatal("returned bytes alias state")
+	}
+	changed := store.state.Operations["first"]
+	changed.Signature = append([]byte(nil), changed.Signature...)
+	changed.Signature[0] = '!'
+	store.state.Operations["first"] = changed
+	if _, err := NewPersistent(registryMock{status: AgentActive}, credentialMock{}, nil, nil, nil, store, ""); err == nil {
+		t.Fatal("tampered durable receipt accepted")
+	}
+}
+func TestOperationDiskV1MigrationPreservesRevocationsAndGenerations(t *testing.T) {
+	store := newTestStateStore()
+	s := testPersistent(t, store, "")
+	old, err := s.IssuePassport(persistentIssue("none", 0))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err = s.RevokePassportConditional(context.Background(), old.PassportID, "drift", "operator", expectedID(old.PassportID), expectedRev(1)); err != nil {
+		t.Fatal(err)
+	}
+	active, err := s.IssuePassport(persistentIssue("none", 2))
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Actual prior format has no operations field at all.
+	legacy := struct {
+		Version   int                        `json:"version"`
+		Passports map[string]domain.Passport `json:"passports"`
+		Active    map[string]string          `json:"active_by_agent"`
+		Revisions map[string]uint64          `json:"revisions"`
+	}{1, store.state.Passports, store.state.ActiveByAgent, store.state.Revisions}
+	raw, _ := json.Marshal(legacy)
+	path := filepath.Join(t.TempDir(), "state.json")
+	if err = os.WriteFile(path, raw, 0600); err != nil {
+		t.Fatal(err)
+	}
+	file, err := OpenFileStore(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer file.Close()
+	s = testPersistent(t, file, "")
+	unchanged, _ := os.ReadFile(path)
+	if !bytes.Equal(raw, unchanged) {
+		t.Fatal("startup rewrote old state")
+	}
+	revoked, _, _ := s.GetPassportRevision(old.PassportID)
+	if revoked.Status != domain.StatusRevoked || revoked.RevocationReason != "drift" {
+		t.Fatal("migration lost revocation")
+	}
+	applyOperation(t, s, issueOperation("upgrade", active.PassportID, 3))
+	state, err := file.Load()
+	if err != nil || state.Version != 2 || state.Revisions["agent"] != 4 || len(state.Operations) != 1 {
+		t.Fatal("migration lost state", err)
+	}
+	if _, err := s.GetOperation("agent", "historical-unrecorded"); !errors.Is(err, ErrNotFound) {
+		t.Fatal("migration fabricated operation", err)
+	}
+}
+
+func TestOperationRequestAllFieldsAreBound(t *testing.T) {
+	s := testPersistent(t, newTestStateStore(), "")
+	applyOperation(t, s, issueOperation("bound", "", 0))
+	cases := map[string]func(*OperationRequest){
+		"passport_type":  func(r *OperationRequest) { r.Issue.PassportType = "PROVISIONAL" },
+		"actor":          func(r *OperationRequest) { r.Issue.IssuedBy = "other" },
+		"passport_ttl":   func(r *OperationRequest) { r.Issue.TTLSeconds = 301 },
+		"scope_ttl":      func(r *OperationRequest) { r.Issue.RequestedScopes[0].ScopeTTLSeconds = 61 },
+		"scope_action":   func(r *OperationRequest) { r.Issue.RequestedScopes[0].ActionClass = "READ" },
+		"scope_resource": func(r *OperationRequest) { r.Issue.RequestedScopes[0].ResourcePattern = "other/*" },
+		"scope_context":  func(r *OperationRequest) { r.Issue.RequestedScopes[0].ContextConstraints["site"] = "B" },
+		"scope_count": func(r *OperationRequest) {
+			r.Issue.RequestedScopes = append(r.Issue.RequestedScopes, r.Issue.RequestedScopes[0])
+		},
+		"force_reissue":     func(r *OperationRequest) { r.Issue.ForceReissue = true },
+		"expected_active":   func(r *OperationRequest) { r.ExpectedActivePassportID = "different" },
+		"expected_revision": func(r *OperationRequest) { r.ExpectedAgentRevision = 2 },
+		"reason":            func(r *OperationRequest) { r.Issue.Reason = "other" },
+	}
+	for name, mutate := range cases {
+		t.Run(name, func(t *testing.T) {
+			r := issueOperation("bound", "", 0)
+			mutate(&r)
+			if _, err := s.ApplyOperation(context.Background(), r); !errors.Is(err, ErrOperationConflict) {
+				t.Fatalf("changed request did not conflict: %v", err)
+			}
+		})
+	}
+	_, revision, _ := s.GetAgentPassportRevision("agent")
+	if revision != 1 {
+		t.Fatal("conflicts advanced revision")
+	}
+}
