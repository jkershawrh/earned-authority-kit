+)
+
+func TestEd25519KeyPersistsAndPinsIssuer(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "signing.pem")
+	first, err := OpenEd25519Credentials(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	id, key, sig, err := first.Sign([]byte("authority"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	second, err := OpenEd25519Credentials(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	id2, key2, sig2, _ := second.Sign([]byte("authority"))
+	if id != id2 || key != key2 || !bytes.Equal(sig, sig2) {
+		t.Fatal("signing identity changed on restart")
+	}
+	valid, err := second.Verify(key, []byte("authority"), sig)
+	if err != nil || !valid {
+		t.Fatal("real signature failed", err)
+	}
+	valid, _ = second.Verify(key, []byte("tampered"), sig)
+	if valid {
+		t.Fatal("tampered message verified")
+	}
+	other, err := OpenEd25519Credentials(filepath.Join(t.TempDir(), "other.pem"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, otherKey, otherSig, _ := other.Sign([]byte("authority"))
+	valid, _ = second.Verify(otherKey, []byte("authority"), otherSig)
+	if valid {
+		t.Fatal("untrusted signer accepted")
+	}
+	if err = os.Chmod(path, 0644); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = OpenEd25519Credentials(path); err == nil {
+		t.Fatal("world-readable key accepted")
+	}
+}
+func TestRegistryHTTPFailsClosed(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		code int
+		body string
+		want service.AgentStatus
+	}{
+		{"active", 200, `{"agent":{"agent_id":"agent","status":"ACTIVE"}}`, service.AgentActive},
+		{"suspended", 200, `{"agent":{"agent_id":"agent","status":"SUSPENDED"}}`, service.AgentSuspended},
+		{"wrong_identity", 200, `{"agent":{"agent_id":"other","status":"ACTIVE"}}`, ""},
+		{"missing", 404, `{}`, ""}, {"unavailable", 503, `{}`, ""}, {"unknown_status", 200, `{"agent":{"agent_id":"agent","status":"UNKNOWN"}}`, ""},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.Header.Get("Authorization") != "Bearer token" {
+					t.Error("missing registry credential")
+				}
+				w.WriteHeader(tc.code)
+				_, _ = w.Write([]byte(tc.body))
+			}))
+			defer server.Close()
+			got, err := (RegistryHTTP{BaseURL: server.URL, Token: "token"}).GetAgentStatus("agent")
+			if tc.want == "" {
+				if err == nil {
+					t.Fatal("bad registry result accepted")
+				}
+			} else if err != nil || got != tc.want {
+				t.Fatalf("status=%q err=%v", got, err)
+			}
+		})
+	}
+}
+func TestDurableRestartRetainsRevocationAndRevision(t *testing.T) {
+	registry := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_ = json.NewEncoder(w).Encode(map[string]any{"agent": map[string]string{"agent_id": strings.TrimPrefix(r.URL.Path, "/v1/identity/agents/"), "status": "ACTIVE"}})
+	}))
+	defer registry.Close()
+	dir := t.TempDir()
+	cfg := DurableConfig{StatePath: filepath.Join(dir, "state.json"), KeyPath: filepath.Join(dir, "key.pem"), RegistryURL: registry.URL, PolicyID: "policy", PolicyVersion: "1"}
+	open := func() (*service.Service, func() error) {
+		s, close, err := NewDurableService(cfg)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return s, close
+	}
+	s, close := open()
+	none := "none"
+	zero := uint64(0)
+	input := service.IssueInput{AgentID: "agent", PassportType: domain.TypeStandard, Scopes: []domain.Scope{{ScopeID: "scope", ActionClass: "WRITE", ResourcePattern: "model/*", ContextConstraints: map[string]string{"site": "A"}, GrantedTS: time.Now().UTC(), ExpiresTS: time.Now().UTC().Add(time.Hour)}}, TTLSeconds: 3600, IssuedBy: "authority", Reason: "qualified", ExpectedActivePassportID: &none, ExpectedAgentRevision: &zero}
+	p, err := s.IssuePassport(input)
+	if err != nil {
+		t.Fatal(err)
+	}
+	valid, _, _, err := s.VerifyPassport(p.PassportID, nil, nil)
+	if err != nil || !valid {
+		t.Fatal("stored real signature verification failed", err)
+	}
+	if err = close(); err != nil {
+		t.Fatal(err)
+	}
+	s, close = open()
+	got, revision, err := s.GetAgentPassportRevision("agent")
+	if err != nil || got.PassportID != p.PassportID || revision != 1 {
+		t.Fatalf("restart lost active credential: %+v %d %v", got, revision, err)
+	}
+	_, revision, err = s.RevokePassportConditional(context.Background(), p.PassportID, "changed site", "authority", &p.PassportID, &revision)
+	if err != nil || revision != 2 {
+		t.Fatal(revision, err)
+	}
+	close()
+	s, close = open()
+	defer close()
+	_, revision, err = s.GetAgentPassportRevision("agent")
+	if !errors.Is(err, service.ErrNotFound) || revision != 2 {
+		t.Fatal("revocation/revision did not survive restart", revision, err)
+	}
+	valid, _, reason, err := s.VerifyPassport(p.PassportID, nil, nil)
+	if err != nil || valid || reason != "revoked" {
+		t.Fatal("revocation did not survive", valid, reason, err)
+	}
+	if _, err = s.IssuePassport(input); !errors.Is(err, service.ErrFailedPrecondition) {
+		t.Fatal("ABA accepted after restart", err)
+	}
+	input.ExpectedAgentRevision = &revision
+	next, err := s.IssuePassport(input)
+	if err != nil || next.Revision != 3 {
+		t.Fatal("reinstatement failed", next.Revision, err)
+	}
+}
