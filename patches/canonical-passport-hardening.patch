+		t.Fatal("operation reused with altered request", err)
+	}
+}
+func TestOperationTransportRejectsAmbiguousBodyAndCASMetadata(t *testing.T) {
+	client := transportClient(t)
+	request := &pb.ApplyPassportOperationRequest{OperationId: "operation1", AgentId: "agent", Mutation: &pb.ApplyPassportOperationRequest_Issue{Issue: issueRequest()}}
