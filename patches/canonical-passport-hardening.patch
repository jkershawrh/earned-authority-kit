+package service
+
+import (
+	"context"
+	"errors"
+	"path/filepath"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/srex-dev/agent-passport/internal/domain"
+)
+
+type testStateStore struct {
+	state State
+	err   error
+}
+
+func newTestStateStore() *testStateStore {
+	return &testStateStore{state: State{Version: 1, Passports: map[string]domain.Passport{}, ActiveByAgent: map[string]string{}, Revisions: map[string]uint64{}}}
+}
+func (m *testStateStore) Load() (State, error) { return m.state, nil }
+func (m *testStateStore) Save(s State) error {
+	if m.err != nil {
+		return m.err
+	}
+	m.state = s
+	return nil
+}
+func expectedID(s string) *string  { return &s }
+func expectedRev(n uint64) *uint64 { return &n }
+func persistentIssue(expected string, revision uint64) IssueInput {
+	return IssueInput{AgentID: "agent", PassportType: domain.TypeStandard, Scopes: []domain.Scope{scope("WRITE")}, TTLSeconds: 3600, IssuedBy: "authority", Reason: "qualification", ExpectedActivePassportID: expectedID(expected), ExpectedAgentRevision: expectedRev(revision)}
+}
+func testPersistent(t *testing.T, store StateStore, fence string) *Service {
+	t.Helper()
+	s, err := NewPersistent(registryMock{status: AgentActive}, credentialMock{}, nil, nil, bundleMock{id: "policy", ver: "1"}, store, fence)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return s
+}
+
+func TestPersistenceFailureIsAtomic(t *testing.T) {
+	store := newTestStateStore()
+	s := testPersistent(t, store, "")
+	first, err := s.IssuePassport(persistentIssue("none", 0))
+	if err != nil {
+		t.Fatal(err)
+	}
+	store.err = errors.New("disk full")
+	replacement := persistentIssue(first.PassportID, 1)
+	replacement.ForceReissue = true
+	if _, err = s.IssuePassport(replacement); !errors.Is(err, ErrUnavailable) {
+		t.Fatal(err)
+	}
+	active, rev, err := s.GetAgentPassportRevision("agent")
+	if err != nil || active.PassportID != first.PassportID || active.Status != domain.StatusActive || rev != 1 {
+		t.Fatalf("replacement changed state: %+v %d %v", active, rev, err)
+	}
+	if _, _, err = s.RevokePassportConditional(context.Background(), first.PassportID, "drift", "authority", expectedID(first.PassportID), expectedRev(1)); !errors.Is(err, ErrUnavailable) {
+		t.Fatal(err)
+	}
+	active, rev, err = s.GetAgentPassportRevision("agent")
+	if err != nil || active.Status != domain.StatusActive || rev != 1 {
+		t.Fatalf("revoke changed state: %+v %d %v", active, rev, err)
+	}
+}
+
+func TestUnknownCommitFailsClosedUntilRestart(t *testing.T) {
+	store := newTestStateStore()
+	s := testPersistent(t, store, "")
+	store.err = ErrCommitUnknown
+	if _, err := s.IssuePassport(persistentIssue("none", 0)); !errors.Is(err, ErrUnavailable) {
+		t.Fatal(err)
+	}
+	if _, _, err := s.GetAgentPassportRevision("agent"); !errors.Is(err, ErrUnavailable) {
+		t.Fatal("uncertain store remained readable", err)
+	}
+	store.err = nil
+	if _, err := s.IssuePassport(persistentIssue("none", 0)); !errors.Is(err, ErrUnavailable) {
+		t.Fatal("uncertain service resumed mutations", err)
+	}
+}
+
+func TestCASRequiresBothFieldsAndRejectsCrossFieldMismatch(t *testing.T) {
+	s := testPersistent(t, newTestStateStore(), "")
+	for _, missing := range []string{"id", "revision"} {
+		in := persistentIssue("none", 0)
+		if missing == "id" {
+			in.ExpectedActivePassportID = nil
+		} else {
+			in.ExpectedAgentRevision = nil
+		}
+		if _, err := s.IssuePassport(in); !errors.Is(err, ErrFailedPrecondition) {
+			t.Fatalf("missing %s: %v", missing, err)
+		}
+	}
+	p, err := s.IssuePassport(persistentIssue("none", 0))
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, in := range []IssueInput{persistentIssue("wrong-id", 1), persistentIssue(p.PassportID, 0)} {
+		in.ForceReissue = true
+		if _, err := s.IssuePassport(in); !errors.Is(err, ErrFailedPrecondition) {
+			t.Fatal(err)
+		}
+	}
+	_, rev, err := s.RevokePassportConditional(context.Background(), p.PassportID, "drift", "authority", expectedID(p.PassportID), expectedRev(1))
+	if err != nil || rev != 2 {
+		t.Fatalf("revoke rev=%d err=%v", rev, err)
+	}
+	if _, err := s.IssuePassport(persistentIssue("none", 0)); !errors.Is(err, ErrFailedPrecondition) {
+		t.Fatal("empty-state ABA authorized", err)
+	}
+	p, err = s.IssuePassport(persistentIssue("none", 2))
+	if err != nil || p.Revision != 3 {
+		t.Fatalf("fresh empty CAS failed: %+v %v", p, err)
+	}
+}
+
+func TestConcurrentCASHasSingleWinner(t *testing.T) {
+	s := testPersistent(t, newTestStateStore(), "")
+	var wg sync.WaitGroup
+	results := make(chan error, 16)
+	for i := 0; i < 16; i++ {
+		wg.Add(1)
+		go func() { defer wg.Done(); _, err := s.IssuePassport(persistentIssue("none", 0)); results <- err }()
+	}
+	wg.Wait()
+	close(results)
+	winners := 0
+	for err := range results {
+		if err == nil {
+			winners++
+		} else if !errors.Is(err, ErrFailedPrecondition) {
+			t.Fatal(err)
+		}
+	}
+	if winners != 1 {
+		t.Fatalf("CAS winners=%d", winners)
+	}
+}
+
+func TestFenceBlocksMutationButNotReadsAndHonorsCancellation(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "authority.fence")
+	s := testPersistent(t, newTestStateStore(), path)
+	p, err := s.IssuePassport(persistentIssue("none", 0))
+	if err != nil {
+		t.Fatal(err)
+	}
+	unlock, err := acquireFence(context.Background(), path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unlock()
+	ctx, cancel := context.WithTimeout(context.Background(), 100*time.Millisecond)
+	defer cancel()
+	result := make(chan error, 1)
+	go func() {
+		_, _, err := s.RevokePassportConditional(ctx, p.PassportID, "drift", "authority", expectedID(p.PassportID), expectedRev(1))
+		result <- err
+	}()
+	active, rev, err := s.GetAgentPassportRevision("agent")
+	if err != nil || active.PassportID != p.PassportID || rev != 1 {
+		t.Fatalf("fenced read failed: %+v %d %v", active, rev, err)
+	}
+	select {
+	case err := <-result:
+		if !errors.Is(err, ErrUnavailable) {
+			t.Fatal(err)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("mutation deadlocked instead of observing context")
+	}
+	active, _, _ = s.GetAgentPassportRevision("agent")
+	if active.Status != domain.StatusActive {
+		t.Fatal("canceled fenced mutation applied")
+	}
+}
+
+func TestFileStoreSingleWriterAndCorruption(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "state.json")
+	store, err := OpenFileStore(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer store.Close()
+	if second, err := OpenFileStore(path); err == nil {
+		second.Close()
+		t.Fatal("second writer accepted")
+	}
+	s := testPersistent(t, store, "")
+	p, err := s.IssuePassport(persistentIssue("none", 0))
+	if err != nil {
+		t.Fatal(err)
+	}
+	state, err := store.Load()
+	if err != nil {
+		t.Fatal(err)
+	}
+	changed := state.Passports[p.PassportID]
+	changed.ScopeSet[0].ContextConstraints = map[string]string{"site": "forged"}
+	state.Passports[p.PassportID] = changed
+	if err = store.Save(state); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = NewPersistent(registryMock{status: AgentActive}, credentialMock{}, nil, nil, nil, store, ""); err == nil {
+		t.Fatal("tampered persistent credential loaded")
+	}
+}
