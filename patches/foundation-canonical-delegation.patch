+}
+func TestCanonicalDelegationRevokeMutatesServiceNotReplica(t *testing.T) {
+	h, client, mem := delegationFixture(t)
+	code, result := authorityRequest(t, h, "/v1/passports:revoke", map[string]any{"passport_id": "passport", "reason": "drift", "revoked_by": "operator"})
+	if code != 200 || client.revokeCalls != 1 {
+		t.Fatalf("canonical revoke absent: %d %v calls=%d", code, result, client.revokeCalls)
+	}
+	body, _, _ := mem.GetPassportBody(context.Background(), "passport")
+	if !strings.Contains(string(body), `"ACTIVE"`) {
+		t.Fatal("local authority replica mutated")
+	}
+}
+
+func TestCanonicalDelegationForwardsCASAndIgnoresLocalPassportConflict(t *testing.T) {
+	_, client, mem := delegationFixture(t)
+	h, err := Handler(Config{Repo: mem, S0: &s0delegate.Backend{Pass: client, PassportMutationToken: "canonical-secret"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	body := `{"agent_id":"agent","passport_type":"STANDARD","requested_scopes":[{"action_class":"READ","resource_pattern":"model/*"}],"ttl_seconds":3600,"issued_by":"operator","reason":"qualified"}`
+	req := httptest.NewRequest(http.MethodPost, "/v1/passports", strings.NewReader(body))
+	req.Header.Set("Idempotency-Key", "new-grant")
+	req.Header.Set("X-ARE-Expected-Active-Passport-ID", "none")
