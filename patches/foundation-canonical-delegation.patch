+package are.evaluatepolicy
+
+test_decision_binds_evaluated_input_and_policy {
+    request := {"decision_id":"d1", "agent_id":"a1", "action_class":"model.promote_to_production", "resource":"model/champion"}
+    binding := {"policy_id":"policy/are_evaluatepolicy.rego", "policy_digest":"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}
+    result := decision with input as request with data.are_policy_binding as binding
+    result.effect == "ALLOW"
+    result.decision_id == request.decision_id
+    result.agent_id == request.agent_id
+    result.action_class == request.action_class
+    result.resource == request.resource
+    result.policy_id == binding.policy_id
+    result.policy_digest == binding.policy_digest
+}
+
+test_missing_policy_binding_does_not_produce_allow {
+    request := {"decision_id":"d1", "agent_id":"a1", "action_class":"model.promote_to_production", "resource":"model/champion"}
+    not decision with input as request with data.are_policy_binding as {}
+}
+
+test_request_cannot_supply_policy_digest {
+    request := {"decision_id":"d1", "agent_id":"a1", "action_class":"model.promote_to_production", "resource":"model/champion", "policy_digest":"forged"}
+    binding := {"policy_id":"policy/are_evaluatepolicy.rego", "policy_digest":"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}
+    result := decision with input as request with data.are_policy_binding as binding
+    result.policy_digest == binding.policy_digest
+    result.policy_digest != request.policy_digest
+}
