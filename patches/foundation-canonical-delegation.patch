new file mode 100644
--- /dev/null
+++ b/sx/are-api-gateway/internal/gateway/canonical_metadata_test.go
@@ -0,0 +1,32 @@
+package gateway
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestCanonicalCASMetadataRoundTrip(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Header.Get("X-ARE-Expected-Active-Passport-ID") != "none" || r.Header.Get("X-ARE-Expected-Agent-Revision") != "3" {
+			t.Errorf("canonical CAS metadata lost: %v", r.Header)
+		}
+		w.Header().Set("X-ARE-Agent-Revision", "4")
+		w.WriteHeader(http.StatusCreated)
+		_, _ = w.Write([]byte(`{"passport":{}}`))
+	}))
+	defer server.Close()
+	proxy, err := NewRESTProxyUpstream(server.URL, server.Client())
+	if err != nil {
+		t.Fatal(err)
+	}
+	gateway := NewGateway(allowToken{}, proxy, nil)
+	req := foundationRequest(http.MethodPost, "/v1/passports", `{}`, "issue")
+	req.Header.Set("X-ARE-Expected-Active-Passport-ID", "none")
+	req.Header.Set("X-ARE-Expected-Agent-Revision", "3")
+	rec := httptest.NewRecorder()
+	gateway.Handler().ServeHTTP(rec, req)
+	if rec.Code != http.StatusCreated || rec.Header().Get("X-ARE-Agent-Revision") != "4" {
+		t.Fatalf("canonical revision response lost: %d %v", rec.Code, rec.Header())
+	}
+}
