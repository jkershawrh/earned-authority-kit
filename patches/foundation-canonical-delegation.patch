+	if client.mutation.Get("authorization")[0] != "Bearer canonical-secret" || client.mutation.Get("x-are-expected-active-passport-id")[0] != "none" || client.mutation.Get("x-are-expected-agent-revision")[0] != "3" || rec.Header().Get("X-ARE-Agent-Revision") != "4" {
+		t.Fatalf("metadata lost: %v %v", client.mutation, rec.Header())
