+func TestCanonicalDelegationUnavailableNeverFallsBack(t *testing.T) {
+	for _, path := range []string{"/v1/passports:verify", "/v1/enforcement/scope:evaluate", "/v1/passports:revoke"} {
+		t.Run(path, func(t *testing.T) {
+			h, client, _ := delegationFixture(t)
