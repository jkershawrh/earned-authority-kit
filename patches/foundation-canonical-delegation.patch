+	if len(passports) != 1 {
+		t.Fatal("canonical passport written into local authority store")
+	}
+}
+func TestCanonicalDelegationValidContextAndCurrentList(t *testing.T) {
+	h, client, _ := delegationFixture(t)
+	client.current.PassportId = "current"
+	client.current.ScopeSet[0].ContextConstraints = map[string]string{"site": "A"}
+	// Match the verification response identity to this canonical current record.
+	code, result := authorityRequest(t, h, "/v1/enforcement/scope:evaluate", map[string]any{"agent_id": "agent", "action_class": "READ", "resource": "model/candidate", "context": map[string]any{"site": "A"}})
+	decision, _ := result["decision"].(map[string]any)
+	if code != 200 || decision["effect"] != "ALLOW" {
+		t.Fatalf("valid delegated scope denied: %d %v", code, result)
+	}
+	req := httptest.NewRequest(http.MethodGet, "/v1/passports/by-agent/agent", nil)
+	rec := httptest.NewRecorder()
+	h.ServeHTTP(rec, req)
+	if rec.Code != 200 || !strings.Contains(rec.Body.String(), `"passport_id":"current"`) || strings.Contains(rec.Body.String(), `"passport_id":"passport"`) {
+		t.Fatal("list used replica", rec.Code, rec.Body.String())
+	}
+}
