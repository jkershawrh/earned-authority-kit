--- /dev/null
+++ b/sx/s0s1-rest-bff/internal/api/authority_checks_test.go
@@ -0,0 +1,284 @@
+package api
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"are-s0s1-rest-bff/internal/repo"
+)
+
+var authorityCheckTime = time.Date(2026, 10, 9, 12, 0, 0, 0, time.UTC)
+
+func authorityRequest(t *testing.T, h http.Handler, path string, body map[string]any) (int, map[string]any) {
+	t.Helper()
+	data, err := json.Marshal(body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	req := httptest.NewRequest(http.MethodPost, path, bytes.NewReader(data))
+	req.Header.Set("Idempotency-Key", "authority-test")
+	w := httptest.NewRecorder()
+	h.ServeHTTP(w, req)
+	var result map[string]any
+	if err := json.Unmarshal(w.Body.Bytes(), &result); err != nil {
+		t.Fatal(err)
+	}
+	return w.Code, result
+}
+
+func authorityHandler(t *testing.T, passport map[string]any) http.Handler {
+	t.Helper()
+	mem := repo.NewMemory()
+	_, err := mem.FinishRegister(context.Background(), "register", "agent", []byte(`{}`), repo.AgentRec{Status: "ACTIVE"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	body, err := json.Marshal(map[string]any{"passport": passport})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := mem.FinishPassport(context.Background(), "issue", "agent", body); err != nil {
+		t.Fatal(err)
+	}
+	h, err := Handler(Config{Repo: mem, Now: func() time.Time { return authorityCheckTime }})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return h
+}
+
+func baseAuthorityPassport() map[string]any {
+	return map[string]any{
+		"passport_id": "passport", "agent_id": "agent", "status": "ACTIVE",
+		"expires_at": authorityCheckTime.Add(time.Hour).Format(time.RFC3339Nano),
+		"scope_set":  []any{map[string]any{"action_class": "model.promote", "resource_pattern": "model/*"}},
+	}
+}
+
+func TestAuthorityPassportExpiry(t *testing.T) {
+	cases := []struct {
+		name   string
+		expiry map[string]any
+		want   bool
+	}{
+		{"rfc3339_future", map[string]any{"expires_at": authorityCheckTime.Add(time.Second).Format(time.RFC3339Nano)}, true},
+		{"rfc3339_expired", map[string]any{"expires_at": authorityCheckTime.Add(-time.Second).Format(time.RFC3339Nano)}, false},
+		{"rfc3339_equal_now", map[string]any{"expires_at": authorityCheckTime.Format(time.RFC3339Nano)}, false},
+		{"milliseconds_future", map[string]any{"expires_ts": authorityCheckTime.UnixMilli() + 1}, true},
+		{"milliseconds_expired", map[string]any{"expires_ts": authorityCheckTime.UnixMilli() - 1}, false},
+		{"milliseconds_equal_now", map[string]any{"expires_ts": authorityCheckTime.UnixMilli()}, false},
+		{"missing", map[string]any{}, false},
+		{"malformed_date", map[string]any{"expires_at": "later"}, false},
+		{"null_date", map[string]any{"expires_at": nil}, false},
+		{"invalid_type", map[string]any{"expires_ts": true}, false},
+		{"fractional_milliseconds", map[string]any{"expires_ts": float64(authorityCheckTime.UnixMilli()) + 0.5}, false},
+		{"milliseconds_overflow", map[string]any{"expires_ts": json.Number("9223372036854775808")}, false},
+		{"both_future", map[string]any{"expires_at": authorityCheckTime.Add(time.Hour).Format(time.RFC3339Nano), "expires_ts": authorityCheckTime.Add(time.Minute).UnixMilli()}, true},
+		{"second_format_expired", map[string]any{"expires_at": authorityCheckTime.Add(time.Hour).Format(time.RFC3339Nano), "expires_ts": authorityCheckTime.UnixMilli() - 1}, false},
+		{"first_format_expired", map[string]any{"expires_at": authorityCheckTime.Add(-time.Hour).Format(time.RFC3339Nano), "expires_ts": authorityCheckTime.Add(time.Minute).UnixMilli()}, false},
+		{"second_format_malformed", map[string]any{"expires_at": authorityCheckTime.Add(time.Hour).Format(time.RFC3339Nano), "expires_ts": "tomorrow"}, false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			passport := baseAuthorityPassport()
+			delete(passport, "expires_at")
+			for k, v := range tc.expiry {
+				passport[k] = v
+			}
+			h := authorityHandler(t, passport)
+			code, result := authorityRequest(t, h, "/v1/passports:verify", map[string]any{"agent_id": "agent", "passport_id": "passport"})
+			if code != http.StatusOK || result["verified"] != tc.want {
+				t.Errorf("verify: code=%d result=%v want=%v", code, result, tc.want)
+			}
+			for _, explicit := range []bool{true, false} {
+				request := map[string]any{"agent_id": "agent", "action_class": "model.promote", "resource": "model/candidate"}
+				if explicit {
+					request["passport_id"] = "passport"
+				}
+				code, result = authorityRequest(t, h, "/v1/enforcement/scope:evaluate", request)
+				want := "DENY"
+				if tc.want {
+					want = "ALLOW"
+				}
+				decision, _ := result["decision"].(map[string]any)
+				if code != http.StatusOK || decision["effect"] != want {
+					t.Errorf("scope explicit=%v: code=%d result=%v want=%s", explicit, code, result, want)
+				}
+			}
+		})
+	}
+}
+
+func TestAuthorityScopeExpiryAndContext(t *testing.T) {
+	cases := []struct {
+		name    string
+		scope   map[string]any
+		context any
+		want    string
+	}{
+		{"unrestricted_scope_inherits_passport_expiry", nil, map[string]any{"site": "A"}, "ALLOW"},
+		{"scope_expired", map[string]any{"expires_ts": authorityCheckTime.UnixMilli() - 1}, nil, "DENY"},
+		{"scope_equal_now", map[string]any{"expires_ts": authorityCheckTime.UnixMilli()}, nil, "DENY"},
+		{"scope_future", map[string]any{"expires_ts": authorityCheckTime.UnixMilli() + 1}, nil, "ALLOW"},
+		{"scope_expired_date", map[string]any{"expires_at": authorityCheckTime.Add(-time.Second).Format(time.RFC3339Nano)}, nil, "DENY"},
+		{"scope_malformed_expiry", map[string]any{"expires_ts": "invalid"}, nil, "DENY"},
+		{"scope_null_expiry", map[string]any{"expires_ts": nil}, nil, "DENY"},
+		{"scope_context_match", map[string]any{"context_constraints": map[string]any{"site": "A"}}, map[string]any{"site": "A"}, "ALLOW"},
+		{"scope_context_wrong_site", map[string]any{"context_constraints": map[string]any{"site": "A"}}, map[string]any{"site": "B"}, "DENY"},
+		{"scope_context_missing", map[string]any{"context_constraints": map[string]any{"site": "A"}}, nil, "DENY"},
+		{"scope_context_extra_key", map[string]any{"context_constraints": map[string]any{"site": "A"}}, map[string]any{"site": "A", "mode": "other"}, "DENY"},
+		{"scope_context_invalid_type", map[string]any{"context_constraints": "site=A"}, nil, "DENY"},
+		{"scope_context_null", map[string]any{"context_constraints": nil}, nil, "DENY"},
+		{"scope_context_nonstring_value", map[string]any{"context_constraints": map[string]any{"site": 1}}, map[string]any{"site": "1"}, "DENY"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			passport := baseAuthorityPassport()
+			scope := passport["scope_set"].([]any)[0].(map[string]any)
+			for k, v := range tc.scope {
+				scope[k] = v
+			}
+			h := authorityHandler(t, passport)
+			for _, explicit := range []bool{true, false} {
+				request := map[string]any{"agent_id": "agent", "action_class": "model.promote", "resource": "model/candidate"}
+				if explicit {
+					request["passport_id"] = "passport"
+				}
+				if tc.context != nil {
+					request["context"] = tc.context
+				}
+				code, result := authorityRequest(t, h, "/v1/enforcement/scope:evaluate", request)
+				decision, _ := result["decision"].(map[string]any)
+				if code != http.StatusOK || decision["effect"] != tc.want {
+					t.Errorf("scope explicit=%v code=%d result=%v want=%s", explicit, code, result, tc.want)
+				}
+			}
+		})
+	}
+}
+
+func TestAuthorityScopeRejectsMalformedRequestContext(t *testing.T) {
+	for _, bad := range []any{nil, "site=A", []any{"A"}, map[string]any{"site": 1}} {
+		h := authorityHandler(t, baseAuthorityPassport())
+		code, result := authorityRequest(t, h, "/v1/enforcement/scope:evaluate", map[string]any{"agent_id": "agent", "action_class": "model.promote", "resource": "model/candidate", "context": bad})
+		if code != http.StatusBadRequest {
+			t.Errorf("context=%v code=%d result=%v", bad, code, result)
+		}
+	}
+}
+
+func TestAuthorityLocalIssuePreservesConditions(t *testing.T) {
+	mem := repo.NewMemory()
+	now := authorityCheckTime
+	h, err := Handler(Config{Repo: mem, Now: func() time.Time { return now }})
+	if err != nil {
+		t.Fatal(err)
+	}
+	code, _ := authorityRequest(t, h, "/v1/identity/agents", map[string]any{"agent_type": "demo", "owner_id": "owner"})
+	if code != http.StatusCreated {
+		t.Fatal(code)
+	}
+	code, result := authorityRequest(t, h, "/v1/passports", map[string]any{
+		"agent_id": "agt-authority-test", "passport_type": "STANDARD", "ttl_seconds": 3600, "issued_by": "operator", "reason": "qualification",
+		"requested_scopes": []any{map[string]any{"action_class": "model.promote", "resource_pattern": "model/*", "scope_ttl_seconds": 60, "context_constraints": map[string]any{"site": "A"}}},
+	})
+	if code != http.StatusCreated {
+		t.Fatalf("issue: code=%d result=%v", code, result)
+	}
+	for _, tc := range []struct {
+		name, site, want string
+		offset           time.Duration
+	}{
+		{"qualified_site_before_expiry", "A", "ALLOW", 59 * time.Second},
+		{"other_site", "B", "DENY", 59 * time.Second},
+		{"at_scope_expiry", "A", "DENY", 60 * time.Second},
+		{"after_scope_expiry", "A", "DENY", 61 * time.Second},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			now = authorityCheckTime.Add(tc.offset)
+			code, result := authorityRequest(t, h, "/v1/enforcement/scope:evaluate", map[string]any{"agent_id": "agt-authority-test", "passport_id": "ppt-authority-test", "action_class": "model.promote", "resource": "model/candidate", "context": map[string]any{"site": tc.site}})
+			decision, _ := result["decision"].(map[string]any)
+			if code != http.StatusOK || decision["effect"] != tc.want {
+				t.Errorf("code=%d result=%v want=%s", code, result, tc.want)
+			}
+		})
+	}
+}
+
+func TestAuthorityLocalIssueRejectsMalformedConditions(t *testing.T) {
+	for _, tc := range []struct {
+		name, field string
+		value       any
+	}{
+		{"context_not_object", "context_constraints", "site=A"},
+		{"context_null", "context_constraints", nil},
+		{"context_value_not_string", "context_constraints", map[string]any{"site": 1}},
+		{"scope_ttl_fractional", "scope_ttl_seconds", 1.5},
+		{"scope_ttl_negative", "scope_ttl_seconds", -1},
+		{"scope_ttl_null", "scope_ttl_seconds", nil},
+		{"scope_ttl_overflow", "scope_ttl_seconds", json.Number("9223372036854775808")},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			mem := repo.NewMemory()
+			h, err := Handler(Config{Repo: mem, Now: func() time.Time { return authorityCheckTime }})
+			if err != nil {
+				t.Fatal(err)
+			}
+			code, _ := authorityRequest(t, h, "/v1/identity/agents", map[string]any{"agent_type": "demo", "owner_id": "owner"})
+			if code != http.StatusCreated {
+				t.Fatal(code)
+			}
+			scope := map[string]any{"action_class": "model.promote", "resource_pattern": "model/*", tc.field: tc.value}
+			code, result := authorityRequest(t, h, "/v1/passports", map[string]any{"agent_id": "agt-authority-test", "passport_type": "STANDARD", "ttl_seconds": 3600, "issued_by": "operator", "reason": "qualification", "requested_scopes": []any{scope}})
+			if code != http.StatusBadRequest {
+				t.Fatalf("code=%d result=%v", code, result)
+			}
+			bodies, err := mem.ListPassportBodiesByAgent(context.Background(), "agt-authority-test")
+			if err != nil || len(bodies) != 0 {
+				t.Fatalf("invalid request stored authority: %v %v", bodies, err)
+			}
+		})
+	}
+}
+
+func TestAuthorityStillRequiresBindingAndActiveStatus(t *testing.T) {
+	for _, tc := range []struct{ name, field, value string }{
+		{"wrong_agent", "agent_id", "different-agent"},
+		{"revoked", "status", "REVOKED"},
+		{"expired_status", "status", "EXPIRED"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			passport := baseAuthorityPassport()
+			passport[tc.field] = tc.value
+			h := authorityHandler(t, passport)
+			_, result := authorityRequest(t, h, "/v1/passports:verify", map[string]any{"agent_id": "agent", "passport_id": "passport"})
+			if result["verified"] != false {
+				t.Fatalf("verify: %v", result)
+			}
+			_, result = authorityRequest(t, h, "/v1/enforcement/scope:evaluate", map[string]any{"agent_id": "agent", "passport_id": "passport", "action_class": "model.promote", "resource": "model/candidate"})
+			decision, _ := result["decision"].(map[string]any)
+			if decision["effect"] != "DENY" {
+				t.Fatalf("scope: %v", result)
+			}
+		})
+	}
+}
+
+func TestAuthorityExpiredScopeDoesNotHideOtherValidScope(t *testing.T) {
+	passport := baseAuthorityPassport()
+	passport["scope_set"] = []any{
+		map[string]any{"action_class": "model.promote", "resource_pattern": "model/*", "expires_ts": authorityCheckTime.UnixMilli() - 1},
+		map[string]any{"action_class": "model.promote", "resource_pattern": "model/*", "expires_ts": authorityCheckTime.UnixMilli() + 1, "context_constraints": map[string]any{"site": "A"}},
+	}
+	h := authorityHandler(t, passport)
+	_, result := authorityRequest(t, h, "/v1/enforcement/scope:evaluate", map[string]any{"agent_id": "agent", "action_class": "model.promote", "resource": "model/candidate", "context": map[string]any{"site": "A"}})
+	decision, _ := result["decision"].(map[string]any)
+	if decision["effect"] != "ALLOW" {
+		t.Fatalf("scope: %v", result)
+	}
+}
diff --git a/sx/s0s1-rest-bff/internal/api/canonical_delegation_test.go b/sx/s0s1-rest-bff/internal/api/canonical_delegation_test.go
