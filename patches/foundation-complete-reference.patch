diff --git a/sx/s0s1-rest-bff/internal/s0delegate/passport_canonical.go b/sx/s0s1-rest-bff/internal/s0delegate/passport_canonical.go
new file mode 100644
--- /dev/null
+++ b/sx/s0s1-rest-bff/internal/s0delegate/passport_canonical.go
@@ -0,0 +1,127 @@
+package s0delegate
+
+import (
+	"context"
+	"encoding/json"
+	"strconv"
+	"time"
+
+	passportv1 "github.com/srex-dev/are-foundation/s0/passport-issuance-engine/proto"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/metadata"
+	"google.golang.org/grpc/status"
+)
+
+func MutationContext(ctx context.Context, token, expectedID, expectedRevision string) context.Context {
+	pairs := []string{}
+	if token != "" {
+		pairs = append(pairs, "authorization", "Bearer "+token)
+	}
+	if expectedID != "" {
+		pairs = append(pairs, "x-are-expected-active-passport-id", expectedID)
+	}
+	if expectedRevision != "" {
+		pairs = append(pairs, "x-are-expected-agent-revision", expectedRevision)
+	}
+	return metadata.AppendToOutgoingContext(ctx, pairs...)
+}
+func sourceRevision(header, trailer metadata.MD) (string, error) {
+	values := header.Get("x-are-agent-revision")
+	if len(values) == 0 {
+		values = trailer.Get("x-are-agent-revision")
+	}
+	if len(values) != 1 {
+		return "", status.Error(codes.Unavailable, "canonical agent revision missing")
+	}
+	if _, err := strconv.ParseUint(values[0], 10, 64); err != nil {
+		return "", status.Error(codes.Unavailable, "canonical agent revision invalid")
+	}
+	return values[0], nil
+}
+func ReadCanonicalPassport(ctx context.Context, c passportv1.PassportIssuanceServiceClient, id string) (map[string]any, string, error) {
+	ctx, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	var header, trailer metadata.MD
+	response, err := c.GetPassport(ctx, &passportv1.GetPassportRequest{PassportId: id}, grpc.Header(&header), grpc.Trailer(&trailer))
+	revision, metaErr := sourceRevision(header, trailer)
+	if err != nil {
+		return nil, revision, err
+	}
+	if metaErr != nil {
+		return nil, "", metaErr
+	}
+	if response == nil || response.Passport == nil || response.Passport.PassportId != id {
+		return nil, revision, status.Error(codes.Unavailable, "canonical passport identity mismatch")
+	}
+	return passportToMap(response.Passport), revision, nil
+}
+func ReadCanonicalAgentPassport(ctx context.Context, c passportv1.PassportIssuanceServiceClient, agent string) (map[string]any, string, error) {
+	ctx, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	var header, trailer metadata.MD
+	response, err := c.GetAgentPassport(ctx, &passportv1.GetAgentPassportRequest{AgentId: agent}, grpc.Header(&header), grpc.Trailer(&trailer))
+	revision, metaErr := sourceRevision(header, trailer)
+	if err != nil {
+		return nil, revision, err
+	}
+	if metaErr != nil {
+		return nil, "", metaErr
+	}
+	if response == nil || response.Passport == nil || response.Passport.AgentId != agent {
+		return nil, revision, status.Error(codes.Unavailable, "canonical agent identity mismatch")
+	}
+	return passportToMap(response.Passport), revision, nil
+}
+func VerifyCanonicalPassport(ctx context.Context, c passportv1.PassportIssuanceServiceClient, id string) (bool, string, string, error) {
+	ctx, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	var header, trailer metadata.MD
+	response, err := c.VerifyPassport(ctx, &passportv1.VerifyPassportRequest{PassportId: id}, grpc.Header(&header), grpc.Trailer(&trailer))
+	revision, metaErr := sourceRevision(header, trailer)
+	if err != nil {
+		return false, "", revision, err
+	}
+	if metaErr != nil {
+		return false, "", "", metaErr
+	}
+	if response == nil || response.PassportId != id {
+		return false, "", revision, status.Error(codes.Unavailable, "canonical verification identity mismatch")
+	}
+	return response.Valid, response.FailureReason, revision, nil
+}
+func IssueCanonicalPassport(ctx context.Context, c passportv1.PassportIssuanceServiceClient, req *passportv1.IssuePassportRequest) ([]byte, string, error) {
+	ctx, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	var header, trailer metadata.MD
+	response, err := c.IssuePassport(ctx, req, grpc.Header(&header), grpc.Trailer(&trailer))
+	revision, metaErr := sourceRevision(header, trailer)
+	if err != nil {
+		return nil, revision, err
+	}
+	if metaErr != nil {
+		return nil, "", metaErr
+	}
+	if response == nil || response.Passport == nil || response.Passport.AgentId != req.AgentId {
+		return nil, revision, status.Error(codes.Unavailable, "canonical issuance identity mismatch")
+	}
+	body, err := json.Marshal(map[string]any{"passport": passportToMap(response.Passport)})
+	return body, revision, err
+}
+func RevokeCanonicalPassport(ctx context.Context, c passportv1.PassportIssuanceServiceClient, id, reason, actor string) (map[string]any, string, error) {
+	ctx, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	var header, trailer metadata.MD
+	response, err := c.RevokePassport(ctx, &passportv1.RevokePassportRequest{PassportId: id, Reason: reason, RevokedBy: actor}, grpc.Header(&header), grpc.Trailer(&trailer))
+	revision, metaErr := sourceRevision(header, trailer)
+	if err != nil {
+		return nil, revision, err
+	}
+	if metaErr != nil {
+		return nil, "", metaErr
+	}
+	if response == nil || response.PassportId != id || response.Status != "REVOKED" {
+		return nil, revision, status.Error(codes.Unavailable, "canonical revocation response invalid")
+	}
+	return map[string]any{"revoked": true, "passport_id": response.PassportId, "status": response.Status, "revoked_ts": response.RevokedTs, "reason": reason}, revision, nil
+}
