+		result["policy_id"] = "policy/test.rego"
+		result["policy_digest"] = "sha256:" + strings.Repeat("a", 64)
+		_ = json.NewEncoder(w).Encode(map[string]any{"result": result})
 	}))
 	defer srv.Close()
 	c := policy.NewOPAClient(srv.URL, time.Second)
