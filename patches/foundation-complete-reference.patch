new file mode 100644
--- /dev/null
+++ b/sx/s0s1-rest-bff/internal/api/api_canonical.go
@@ -0,0 +1,93 @@
+package api
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+
+	"are-s0s1-rest-bff/internal/s0delegate"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+func canonicalEnabled(cfg *Config) bool { return cfg.S0 != nil && cfg.S0.Pass != nil }
+func canonicalRevision(w http.ResponseWriter, revision string) {
+	if revision != "" {
+		w.Header().Set("X-ARE-Agent-Revision", revision)
+	}
+}
+func canonicalMutationContext(r *http.Request, cfg *Config) context.Context {
+	return s0delegate.MutationContext(r.Context(), cfg.S0.PassportMutationToken, r.Header.Get("X-ARE-Expected-Active-Passport-ID"), r.Header.Get("X-ARE-Expected-Agent-Revision"))
+}
+func canonicalVerifiedPassport(ctx context.Context, cfg *Config, agentID, passportID string) (map[string]any, bool, string, string, error) {
+	var passport map[string]any
+	var revision string
+	var err error
+	if passportID != "" {
+		passport, revision, err = s0delegate.ReadCanonicalPassport(ctx, cfg.S0.Pass, passportID)
+	} else {
+		passport, revision, err = s0delegate.ReadCanonicalAgentPassport(ctx, cfg.S0.Pass, agentID)
+	}
+	if status.Code(err) == codes.NotFound {
+		return nil, false, "passport not found", revision, nil
+	}
+	if err != nil {
+		return nil, false, "", revision, err
+	}
+	if passport["agent_id"] != agentID {
+		return passport, false, "passport is not bound to agent", revision, nil
+	}
+	id, _ := passport["passport_id"].(string)
+	verified, reason, verifiedRevision, err := s0delegate.VerifyCanonicalPassport(ctx, cfg.S0.Pass, id)
+	if err != nil {
+		return nil, false, "", verifiedRevision, err
+	}
+	if revision != verifiedRevision {
+		return nil, false, "", verifiedRevision, status.Error(codes.Aborted, "authority changed during check")
+	}
+	if !verified {
+		return passport, false, reason, revision, nil
+	}
+	return passport, true, "passport verified by canonical service", revision, nil
+}
+func verifyDelegatedPassport(w http.ResponseWriter, r *http.Request, cfg *Config, agentID, passportID string) {
+	_, verified, reason, revision, err := canonicalVerifiedPassport(r.Context(), cfg, agentID, passportID)
+	canonicalRevision(w, revision)
+	if err != nil {
+		writeS0DelegateError(w, requestID(r), err)
+		return
+	}
+	w.Header().Set("Content-Type", "application/json")
+	_ = json.NewEncoder(w).Encode(map[string]any{"verified": verified, "reason": reason, "passport_id": passportID, "agent_id": agentID, "request_id": requestID(r), "executed": false, "proof_status": "reference_only"})
+}
+func listDelegatedPassports(w http.ResponseWriter, r *http.Request, cfg *Config, agentID string) {
+	passport, revision, err := s0delegate.ReadCanonicalAgentPassport(r.Context(), cfg.S0.Pass, agentID)
+	canonicalRevision(w, revision)
+	if err != nil && status.Code(err) != codes.NotFound {
+		writeS0DelegateError(w, requestID(r), err)
+		return
+	}
+	passports := []map[string]any{}
+	if err == nil {
+		passports = append(passports, passport)
+	}
+	w.Header().Set("Content-Type", "application/json")
+	_ = json.NewEncoder(w).Encode(map[string]any{"agent_id": agentID, "passports": passports, "request_id": requestID(r)})
+}
+func revokeDelegatedPassport(w http.ResponseWriter, r *http.Request, cfg *Config, passportID, reason, actor string) {
+	if actor == "" {
+		actor = r.Header.Get("X-ARE-Agent-ID")
+	}
+	if actor == "" {
+		jsonError(w, requestID(r), "INVALID_ARGUMENT", "revoked_by or caller agent header required", false, http.StatusBadRequest)
+		return
+	}
+	result, revision, err := s0delegate.RevokeCanonicalPassport(canonicalMutationContext(r, cfg), cfg.S0.Pass, passportID, reason, actor)
+	canonicalRevision(w, revision)
+	if err != nil {
+		writeS0DelegateError(w, requestID(r), err)
+		return
+	}
+	w.Header().Set("Content-Type", "application/json")
+	_ = json.NewEncoder(w).Encode(result)
+}
