+func TestPolicyDecisionForwardsEvaluatedBinding(t *testing.T) {
+	expected := map[string]any{"decision_id": "d1", "agent_id": "agent1", "action_class": "demo.read", "resource": "urn:dataset/test", "policy_id": "policy/test.rego", "policy_digest": "sha256:" + strings.Repeat("a", 64), "effect": "ALLOW", "reason": "evaluated"}
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_ = json.NewEncoder(w).Encode(map[string]any{"result": expected})
+	}))
+	defer srv.Close()
+	h, err := Handler(Config{Repo: repo.NewMemory(), Policy: policy.NewOPAClient(srv.URL, time.Second)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	req := httptest.NewRequest(http.MethodPost, "/v1/policy/evaluations", strings.NewReader(`{"decision_id":"d1","agent_id":"agent1","action_class":"demo.read","resource":"urn:dataset/test"}`))
+	req.Header.Set("X-Request-ID", "req1")
+	req.Header.Set("Idempotency-Key", "idem1")
+	rec := httptest.NewRecorder()
+	h.ServeHTTP(rec, req)
+	if rec.Code != http.StatusOK {
+		t.Fatalf("status %d: %s", rec.Code, rec.Body.String())
+	}
+	var body struct {
+		Decision map[string]any `json:"decision"`
+	}
+	if err = json.Unmarshal(rec.Body.Bytes(), &body); err != nil {
+		t.Fatal(err)
+	}
+	for key, want := range expected {
