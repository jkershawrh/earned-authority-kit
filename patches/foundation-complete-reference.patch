--- /dev/null
+++ b/sx/s0s1-rest-bff/internal/api/authority_checks.go
@@ -0,0 +1,102 @@
+package api
+
+import (
+	"encoding/json"
+	"math"
+	"time"
+)
+
+// authorityUnexpired requires every supplied expiry to be valid and in the
+// future. Passport expiry is mandatory; a scope without its own expiry inherits
+// its passport's bound. This accepts the local REST and delegated S0 formats.
+func authorityUnexpired(record map[string]any, now time.Time, required bool) bool {
+	seen := false
+	if raw, ok := record["expires_at"]; ok {
+		seen = true
+		value, ok := raw.(string)
+		if !ok {
+			return false
+		}
+		expires, err := time.Parse(time.RFC3339Nano, value)
+		if err != nil || !now.Before(expires) {
+			return false
+		}
+	}
+	if raw, ok := record["expires_ts"]; ok {
+		seen = true
+		millis, ok := exactInt64(raw)
+		if !ok || !now.Before(time.UnixMilli(millis)) {
+			return false
+		}
+	}
+	return seen || !required
+}
+
+func passportUsable(passport map[string]any, agentID string, now time.Time) bool {
+	return passport != nil && passport["agent_id"] == agentID && passport["status"] == "ACTIVE" &&
+		authorityUnexpired(passport, now, true)
+}
+
+// Match the S1 runtime's context contract: constrained scopes require the exact
+// string key/value set, while an empty constraint object is unrestricted.
+func scopeContextMatches(scope map[string]any, request map[string]string) bool {
+	raw, exists := scope["context_constraints"]
+	if !exists {
+		return true
+	}
+	constraints, ok := stringObject(raw)
+	if !ok {
+		return false
+	}
+	if len(constraints) == 0 {
+		return true
+	}
+	if len(constraints) != len(request) {
+		return false
+	}
+	for key, value := range constraints {
+		got, ok := request[key]
+		if !ok || got != value {
+			return false
+		}
+	}
+	return true
+}
+
+func stringObject(raw any) (map[string]string, bool) {
+	if typed, ok := raw.(map[string]string); ok && typed != nil {
+		return typed, true
+	}
+	object, ok := raw.(map[string]any)
+	if !ok || object == nil {
+		return nil, false
+	}
+	result := make(map[string]string, len(object))
+	for key, value := range object {
+		str, ok := value.(string)
+		if !ok {
+			return nil, false
+		}
+		result[key] = str
+	}
+	return result, true
+}
+
+func exactInt64(raw any) (int64, bool) {
+	switch value := raw.(type) {
+	case json.Number:
+		n, err := value.Int64()
+		return n, err == nil
+	case float64:
+		if math.IsNaN(value) || math.IsInf(value, 0) || math.Trunc(value) != value || value < math.MinInt64 || value >= math.MaxInt64 {
+			return 0, false
+		}
+		return int64(value), true
+	case int64:
+		return value, true
+	case int:
+		return int64(value), true
+	default:
+		return 0, false
+	}
+}
diff --git a/sx/s0s1-rest-bff/internal/api/authority_checks_test.go b/sx/s0s1-rest-bff/internal/api/authority_checks_test.go
