--- /dev/null
+++ b/sx/s0s1-rest-bff/internal/api/canonical_delegation_test.go
@@ -0,0 +1,180 @@
+package api
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"are-s0s1-rest-bff/internal/repo"
+	"are-s0s1-rest-bff/internal/s0delegate"
+	pb "github.com/srex-dev/are-foundation/s0/passport-issuance-engine/proto"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/metadata"
+	"google.golang.org/grpc/status"
+)
+
+type canonicalClient struct {
+	pb.PassportIssuanceServiceClient
+	unavailable bool
+	current     *pb.Passport
+	revoked     bool
+	revokeCalls int
+	issueCalls  int
+	mutation    metadata.MD
+}
+
+func canonicalMetadata(options []grpc.CallOption) {
+	for _, option := range options {
+		switch o := option.(type) {
+		case grpc.HeaderCallOption:
+			*o.HeaderAddr = metadata.Pairs("x-are-agent-revision", "4")
+		case grpc.TrailerCallOption:
+			*o.TrailerAddr = metadata.Pairs("x-are-agent-revision", "4")
+		}
+	}
+}
+func (c *canonicalClient) GetPassport(_ context.Context, _ *pb.GetPassportRequest, options ...grpc.CallOption) (*pb.GetPassportResponse, error) {
+	if c.unavailable {
+		return nil, status.Error(codes.Unavailable, "offline")
+	}
+	canonicalMetadata(options)
+	return &pb.GetPassportResponse{Passport: c.current}, nil
+}
+func (c *canonicalClient) GetAgentPassport(_ context.Context, _ *pb.GetAgentPassportRequest, options ...grpc.CallOption) (*pb.GetAgentPassportResponse, error) {
+	if c.unavailable {
+		return nil, status.Error(codes.Unavailable, "offline")
+	}
+	canonicalMetadata(options)
+	return &pb.GetAgentPassportResponse{Passport: c.current}, nil
+}
+func (c *canonicalClient) VerifyPassport(_ context.Context, _ *pb.VerifyPassportRequest, options ...grpc.CallOption) (*pb.VerifyPassportResponse, error) {
+	if c.unavailable {
+		return nil, status.Error(codes.Unavailable, "offline")
+	}
+	canonicalMetadata(options)
+	return &pb.VerifyPassportResponse{PassportId: c.current.PassportId, Valid: !c.revoked, Status: c.current.Status, FailureReason: "revoked"}, nil
+}
+func (c *canonicalClient) RevokePassport(ctx context.Context, _ *pb.RevokePassportRequest, options ...grpc.CallOption) (*pb.RevokePassportResponse, error) {
+	c.revokeCalls++
+	c.mutation, _ = metadata.FromOutgoingContext(ctx)
+	if c.unavailable {
+		return nil, status.Error(codes.Unavailable, "offline")
+	}
+	canonicalMetadata(options)
+	return &pb.RevokePassportResponse{PassportId: "passport", Status: "REVOKED", RevokedTs: time.Now().UnixMilli()}, nil
+}
+func (c *canonicalClient) IssuePassport(ctx context.Context, _ *pb.IssuePassportRequest, options ...grpc.CallOption) (*pb.IssuePassportResponse, error) {
+	c.issueCalls++
+	c.mutation, _ = metadata.FromOutgoingContext(ctx)
+	if c.unavailable {
+		return nil, status.Error(codes.Unavailable, "offline")
+	}
+	canonicalMetadata(options)
+	return &pb.IssuePassportResponse{Passport: c.current}, nil
+}
+func delegationFixture(t *testing.T) (http.Handler, *canonicalClient, *repo.Memory) {
+	t.Helper()
+	mem := repo.NewMemory()
+	_, err := mem.FinishRegister(context.Background(), "register", "agent", []byte(`{}`), repo.AgentRec{Status: "ACTIVE"})
+	if err != nil {
