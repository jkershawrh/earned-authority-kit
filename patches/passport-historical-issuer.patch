+func TestHistoricalIssuerVerifiesStoredSignature(t *testing.T) {
+	current, err := OpenEd25519Credentials(filepath.Join(t.TempDir(), "current.pem"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	previous, err := OpenEd25519Credentials(filepath.Join(t.TempDir(), "previous.pem"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, oldKey, oldSig, err := previous.Sign([]byte("stored-receipt"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	valid, _ := current.Verify(oldKey, []byte("stored-receipt"), oldSig)
+	if valid {
+		t.Fatal("historical signature accepted before the issuer was installed")
+	}
+	path := filepath.Join(t.TempDir(), "historical.pem")
+	if err = os.WriteFile(path, []byte(oldKey), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err = current.TrustHistoricalPublicKeys(path); err != nil {
+		t.Fatal(err)
+	}
+	valid, err = current.Verify(oldKey, []byte("stored-receipt"), oldSig)
+	if err != nil || !valid {
+		t.Fatal("installed historical issuer rejected a stored signature", err)
+	}
+	_, newKey, newSig, err := current.Sign([]byte("new-operation"))
+	if err != nil || newKey == oldKey {
+		t.Fatal("new operation did not use the current key", err)
+	}
+	valid, err = current.Verify(newKey, []byte("new-operation"), newSig)
+	if err != nil || !valid {
+		t.Fatal("current signature failed", err)
+	}
+}
