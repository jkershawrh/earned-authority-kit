+// TrustHistoricalPublicKeys installs an explicit previous-issuer set.
+// A missing file leaves only the current key trusted. Receipts do not add trust.
+func (c *Ed25519Credentials) TrustHistoricalPublicKeys(path string) error {
+	if path == "" {
+		return nil
+	}
+	data, err := os.ReadFile(path)
+	if os.IsNotExist(err) {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	rest := data
+	var keys []ed25519.PublicKey
+	for len(bytes.TrimSpace(rest)) != 0 {
+		var block *pem.Block
+		block, rest = pem.Decode(rest)
+		if block == nil {
+			return fmt.Errorf("historical issuer file has trailing data")
+		}
+		if block.Type != "PUBLIC KEY" {
+			return fmt.Errorf("historical issuer file must contain public keys only")
+		}
+		raw, err := x509.ParsePKIXPublicKey(block.Bytes)
+		if err != nil {
+			return err
+		}
+		key, ok := raw.(ed25519.PublicKey)
+		if !ok {
+			return fmt.Errorf("historical issuer key must be Ed25519")
+		}
+		if !bytes.Equal(key, c.public) {
+			keys = append(keys, key)
+		}
+	}
+	c.historical = keys
+	return nil
+}
+
+func (c *Ed25519Credentials) Verify(publicKey string, payload, signature []byte) (bool, error) {
+	key, ok := parseEd25519Public(publicKey)
+	if !ok {
 		return false, nil
 	}
+	trusted := bytes.Equal(key, c.public)
+	if !trusted {
+		for _, old := range c.historical {
+			if bytes.Equal(key, old) {
+				trusted = true
+				break
+			}
+		}
+	}
+	if !trusted {
+		return false, nil
+	}
 	return ed25519.Verify(key, payload, signature), nil
 }
 
